{
  "schema": "hasna.service_contract.v1",
  "name": "billing",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.9.0",
  "description": "Thin agent-facing billing/dunning orchestration over Stripe Billing CLI + MCP + serve. The server defaults to SQLite at the effective data home's data/billing.db (resolved via @hasna/paths; legacy ~/.hasna/billing/billing.db until the XDG data home is adopted); HASNA_BILLING_DATABASE_URL selects the PostgreSQL backend.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "billing",
    "billing-mcp",
    "billing-serve"
  ],
  "serviceSurfaces": [
    {
      "name": "billing-api",
      "kind": "api",
      "status": "supported",
      "bin": "billing-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "billing-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "billing-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "billing-mcp",
      "authMode": "api-key"
    },
    {
      "name": "billing-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "billing",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_BILLING_",
    "aliasEnvPrefix": "BILLING_",
    "sqlitePath": "~/.hasna/billing/billing.db",
    "pgTestGate": {
      "envVar": "HASNA_BILLING_TEST_DATABASE_URL",
      "command": "bun test test/postgresql-live.test.ts"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
