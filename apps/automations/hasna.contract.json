{
  "$schema": "https://github.com/hasna/contracts/schema/hasna.service_contract.v1.json",
  "schema": "hasna.service_contract.v1",
  "name": "automations",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Deterministic automation control plane and daemon for Hasna open-source apps. It owns local automation specs, trigger materialization, deterministic run/action queue state, replay requests, daemon leases, and signed webhook materialization. Local paths resolve via @hasna/paths; the XDG data home is adopted once the store is migrated there or HASNA_DATA_HOME is set.",
  "bins": [
    "automations",
    "automations-daemon"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "operator-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "automations",
      "authMode": "local-only"
    },
    {
      "name": "daemon-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "automations-daemon",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_AUTOMATIONS_",
    "aliasEnvPrefix": "AUTOMATIONS_",
    "sqlitePath": "~/.hasna/automations/automations.db",
    "pgTestGate": {
      "envVar": "HASNA_AUTOMATIONS_TEST_DATABASE_URL",
      "command": "HASNA_AUTOMATIONS_DATABASE_URL=$HASNA_AUTOMATIONS_TEST_DATABASE_URL bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
