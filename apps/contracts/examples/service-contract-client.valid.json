{
  "schema": "hasna.service_contract.v1",
  "name": "demo",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "1.1.0",
  "description": "A hosted-by-default CLI: its bins reach data only through the shared authenticated client; the on-box store opens behind HASNA_DEMO_LOCAL=1 only.",
  "bins": ["demo", "demo-mcp"],
  "hosting": ["user-hosted"],
  "scope": "public",
  "placement": { "hosted": "default" },
  "client": {
    "transport": "hosted",
    "authority": "https://api.hasna.com/demo",
    "credentialChain": "contracts",
    "localOptIn": "HASNA_DEMO_LOCAL",
    "localStoreModule": "src/db/database.ts",
    "readProbe": ["list", "--limit", "1"]
  },
  "storage": {
    "backend": "postgresql",
    "engines": ["sqlite", "postgresql"],
    "envPrefix": "HASNA_DEMO_",
    "pgTestGate": { "envVar": "DEMO_TEST_DATABASE_URL", "command": "bun test tests/postgres-storage.test.ts" }
  },
  "serviceSurfaces": [
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "demo",
      "authMode": "local-only",
      "dataAccess": "hosted",
      "commands": [{ "name": "db migrate", "dataAccess": "server-only" }]
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "demo-mcp",
      "authMode": "api-key",
      "dataAccess": "hosted"
    }
  ]
}
