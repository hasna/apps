{
  "name": "@hasna/notes",
  "version": "0.6.2",
  "description": "Authenticated HTTPS notes CLI, MCP server, SDK, and PostgreSQL-backed notes server.",
  "type": "module",
  "bin": {
    "notes": "bin/notes.mjs",
    "notes-mcp": "bin/notes-mcp.mjs",
    "notes-serve": "bin/notes-serve.mjs"
  },
  "exports": {
    ".": {
      "types": "./sdk/index.d.mts",
      "default": "./sdk/index.mjs"
    },
    "./sdk": {
      "types": "./sdk/index.d.mts",
      "default": "./sdk/index.mjs"
    },
    "./sdk/browser": {
      "types": "./sdk/browser.d.mts",
      "import": "./sdk/browser.mjs"
    },
    "./wire/v1": "./sdk/wire-v1.schema.json",
    "./compat/markdown-format": "./compat/markdown-format.mjs",
    "./events": "./tools/notes-events.mjs"
  },
  "files": [
    "bin",
    "cli/notes.mjs",
    "client",
    "compat",
    "sdk",
    "swift/Package.swift",
    "swift/Sources",
    "swift/Tests",
    "scripts/apply-postgres-migrations.mjs",
    "scripts/pg-test-gate.mjs",
    "src/generated",
    "mcp/notes-mcp.mjs",
    "server/index.mjs",
    "server/app.mjs",
    "server/client-ip.mjs",
    "server/auth.mjs",
    "server/paths.mjs",
    "server/sql.mjs",
    "server/http.mjs",
    "server/notes.mjs",
    "server/env.mjs",
    "server/pg-adapter.mjs",
    "server/pg-migrations.ts",
    "server/storage.mjs",
    "tools/notes-env.mjs",
    "tools/notes-events.mjs",
    "tools/notes-lib.mjs",
    "tools/data-migration.mjs",
    "tools/migration-fs.mjs",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test && bun run test:sdk-types",
    "test:swift-sdk": "bash scripts/test-swift-sdk.sh",
    "test:sdk-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM test/browser-sdk.types.mts",
    "test:pg": "bun scripts/pg-test-gate.mjs",
    "scan:artifact": "bun scripts/scan-artifact.mjs",
    "prepack": "bun run build:sdk-types && bun run scan:artifact",
    "pack:dry": "bun pm pack --dry-run",
    "build:sdk-types": "bun scripts/sdk-declarations.mjs",
    "check:sdk-types": "bun scripts/sdk-declarations.mjs --check",
    "test:sdk-package": "bun scripts/test-sdk-package.mjs"
  },
  "keywords": [
    "notes",
    "mcp",
    "cli",
    "https"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps"
  },
  "bugs": {
    "url": "https://github.com/hasna/apps/issues"
  },
  "homepage": "https://github.com/hasna/apps#readme",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0"
  },
  "dependencies": {
    "@hasna/contracts": "1.0.2",
    "@hasna/events": "0.1.16",
    "hono": "4.13.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/bun": "1.2.4",
    "@types/pg": "^8.15.6",
    "typescript": "5.9.3",
    "@types/node": "25.2.3"
  },
  "private": false,
  "workspaces": [
    "server"
  ],
  "types": "./sdk/index.d.mts"
}
