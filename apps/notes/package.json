{
  "name": "@hasna/notes",
  "version": "0.4.2",
  "description": "Local-first personal notes CLI, MCP server, SDK, and self-hosted notes server (SQLite or PostgreSQL).",
  "type": "module",
  "bin": {
    "notes": "bin/notes.mjs",
    "notes-mcp": "bin/notes-mcp.mjs",
    "notes-serve": "bin/notes-serve.mjs"
  },
  "exports": {
    ".": "./tools/notes-lib.mjs",
    "./sdk": "./sdk/index.mjs",
    "./events": "./tools/notes-events.mjs"
  },
  "files": [
    "bin",
    "cli/notes.mjs",
    "client",
    "sdk/index.mjs",
    "scripts/apply-postgres-migrations.mjs",
    "scripts/pg-test-gate.mjs",
    "src/generated",
    "mcp/notes-mcp.mjs",
    "server/index.mjs",
    "server/app.mjs",
    "server/auth.mjs",
    "server/paths.mjs",
    "server/db.mjs",
    "server/http.mjs",
    "server/notes.mjs",
    "server/env.mjs",
    "server/pg-adapter.mjs",
    "server/pg-migrations.ts",
    "server/storage.mjs",
    "tools/notes-agent.mjs",
    "tools/notes-env.mjs",
    "tools/notes-events.mjs",
    "tools/notes-lib.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:pg": "bun scripts/pg-test-gate.mjs",
    "scan:artifact": "bun scripts/scan-artifact.mjs",
    "prepack": "bun run scan:artifact",
    "pack:dry": "bun pm pack --dry-run"
  },
  "keywords": [
    "notes",
    "mcp",
    "cli",
    "local-first"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps"
  },
  "bugs": {
    "url": "https://github.com/hasna/apps/issues"
  },
  "homepage": "https://github.com/hasna/apps#readme",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0"
  },
  "dependencies": {
    "@hasna/contracts": "0.10.6",
    "@hasna/events": "0.1.16",
    "hono": "4.13.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/bun": "1.2.4",
    "@types/pg": "^8.15.6"
  },
  "private": false,
  "workspaces": [
    "server"
  ]
}
