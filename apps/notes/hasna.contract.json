{
  "schema": "hasna.service_contract.v1",
  "name": "notes",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.10.6",
  "description": "Authenticated HTTPS notes CLI, MCP server, SDK, and self-hosted notes server. Every client requires HASNA_NOTES_API_URL plus HASNA_NOTES_API_KEY, rejects client database DSNs, and has no implicit local fallback. notes-serve alone may select PostgreSQL with HASNA_NOTES_DATABASE_URL or use SQLite. Server data paths are XDG-native through @hasna/paths; legacy ~/.hasna locations move only through the explicit, non-destructive migration command. The personalnotes/v1 wire dialect remains unchanged.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "notes",
    "notes-mcp",
    "notes-serve"
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_NOTES_",
    "sqlitePath": "$XDG_DATA_HOME/hasna/notes/server.db",
    "pgTestGate": {
      "envVar": "NOTES_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "serviceSurfaces": [
    {
      "name": "notes-serve",
      "kind": "api",
      "status": "supported",
      "bin": "notes-serve",
      "authMode": "api-key",
      "openApiPath": "/openapi.json",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      }
    },
    {
      "name": "notes-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "NotesClient",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "notes-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "notes-mcp",
      "authMode": "api-key"
    },
    {
      "name": "notes-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "notes",
      "authMode": "api-key"
    }
  ],
  "metadata": {
    "service": {
      "port": 8788,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretEnvVar": "HASNA_NOTES_API_SIGNING_KEY",
      "migrationCommand": [
        "bun",
        "scripts/apply-postgres-migrations.mjs"
      ]
    },
    "client": {
      "apiUrlEnv": "HASNA_NOTES_API_URL",
      "apiKeyEnv": "HASNA_NOTES_API_KEY",
      "transport": "authenticated-https",
      "localFallback": false,
      "legacyDataMigrationCommand": [
        "notes",
        "storage",
        "migrate-legacy-path",
        "--source",
        "legacy",
        "--yes"
      ]
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
