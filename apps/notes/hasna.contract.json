{
  "schema": "hasna.service_contract.v1",
  "name": "notes",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.2",
  "description": "Authenticated HTTPS Notes CLI, MCP and SDK with a PostgreSQL-only server. Clients resolve their credential and authority through the @hasna/contracts chain per request: HASNA_NOTES_API_KEY, the Keychain item hasna.credentials.notes.api-key, then ~/.hasna/notes/config/credentials (owner-only), and the authority follows HASNA_NOTES_API_URL, the Keychain api-url item, the credentials file, and finally the fleet gateway https://api.hasna.com/notes (the wire dialect lives at the /v1 authority root). Hosted with no credential fails loud on every surface: no SQLite, no local fallback. Clients reject database DSNs. notes-serve requires server-only HASNA_NOTES_DATABASE_URL and fails closed. The personalnotes/v1 wire name and the separate PersonalNotes product remain unchanged.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "notes",
    "notes-mcp",
    "notes-serve"
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "postgresql"
    ],
    "envPrefix": "HASNA_NOTES_",
    "pgTestGate": {
      "envVar": "NOTES_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "serviceSurfaces": [
    {
      "name": "notes-serve",
      "kind": "api",
      "status": "supported",
      "bin": "notes-serve",
      "authMode": "api-key",
      "openApiPath": "/openapi.json",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      }
    },
    {
      "name": "notes-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "NotesClient",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "notes-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "notes-mcp",
      "authMode": "api-key"
    },
    {
      "name": "notes-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "notes",
      "authMode": "api-key"
    }
  ],
  "metadata": {
    "service": {
      "port": 8788,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretEnvVar": "HASNA_NOTES_API_SIGNING_KEY",
      "migrationCommand": [
        "bun",
        "scripts/apply-postgres-migrations.mjs"
      ]
    },
    "client": {
      "apiUrlEnv": "HASNA_NOTES_API_URL",
      "apiKeyEnv": "HASNA_NOTES_API_KEY",
      "transport": "authenticated-https",
      "localFallback": false,
      "legacyDataMigrationCommand": [
        "notes",
        "storage",
        "migrate-legacy-path",
        "--source",
        "legacy",
        "--yes",
        "--plan-fingerprint",
        "<reviewed-dry-run-fingerprint>"
      ]
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
