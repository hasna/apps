{
  "schema": "hasna.service_contract.v1",
  "name": "notes",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.10.6",
  "description": "Local-first personal notes CLI, MCP server, SDK, and self-hosted notes server. Clients use the local SQLite+markdown store or the HTTP API selected by HASNA_NOTES_API_URL; notes-serve reads PostgreSQL selected by HASNA_NOTES_DATABASE_URL or SQLite by default. The local store path resolves via @hasna/paths: the XDG data home (~/.local/share/hasna/notes on Linux) is adopted only once the store is migrated there or HASNA_DATA_HOME is set, and HASNA_NOTES_HOME / HASNA_NOTES_ROOT / NOTES_HOME win unconditionally; the legacy ~/.hasna/notes default stays effective until then. The personalnotes/v1 wire dialect is served identically on both backends.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "notes",
    "notes-mcp",
    "notes-serve"
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_NOTES_",
    "sqlitePath": "~/.hasna/notes/server.db",
    "pgTestGate": {
      "envVar": "NOTES_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "serviceSurfaces": [
    {
      "name": "notes-serve",
      "kind": "api",
      "status": "supported",
      "bin": "notes-serve",
      "authMode": "api-key",
      "openApiPath": "/openapi.json",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      }
    },
    {
      "name": "notes-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "NotesClient",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "notes-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "notes-mcp",
      "authMode": "local-only"
    },
    {
      "name": "notes-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "notes",
      "authMode": "local-only"
    }
  ],
  "metadata": {
    "service": {
      "port": 8788,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretEnvVar": "HASNA_NOTES_API_SIGNING_KEY",
      "migrationCommand": [
        "bun",
        "scripts/apply-postgres-migrations.mjs"
      ]
    },
    "client": {
      "apiUrlEnv": "HASNA_NOTES_API_URL",
      "apiKeyEnv": "HASNA_NOTES_API_KEY"
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
