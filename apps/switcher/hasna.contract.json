{
  "$schema": "./node_modules/@hasna/contracts/src/hasna.contract.schema.json",
  "schema": "hasna.service_contract.v1",
  "name": "switcher",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "1.0.2",
  "description": "Universal provider and model switcher with API-first local and hosted operation. CLI, MCP and SDK resolve one authenticated HTTP authority through @hasna/contracts and fail closed when hosted configuration is missing or invalid. HASNA_SWITCHER_LOCAL=1 deliberately selects an owned loopback API backed by SQLite; hosted https://api.hasna.com/switcher uses PostgreSQL and signed revocable API keys. Provider credentials remain local to the launcher and are never stored or returned by the service.",
  "bins": [
    "switcher",
    "switcher-mcp",
    "switcher-serve"
  ],
  "hosting": [
    "user-hosted",
    "hasna-saas"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "switcher-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "package-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "switcher-mcp",
      "authMode": "api-key"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "switcher",
      "authMode": "api-key"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_SWITCHER_",
    "aliasEnvPrefix": "SWITCHER_",
    "sqlitePath": "~/.hasna/switcher/switcher.db",
    "pgTestGate": {
      "envVar": "SWITCHER_TEST_DATABASE_URL",
      "command": "bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "switcherStorageException": {
      "authority": "Explicit user directive 2026-09-05, task 01a07181-ca8d-70c1-99a2-b276dc5770f3",
      "serverBackends": [
        "sqlite",
        "postgresql"
      ],
      "scope": "The owned local HTTP API uses SQLite; the hosted HTTP API uses PostgreSQL. CLI, SDK and MCP always use authenticated HTTP, and a selected hosted authority never falls back to local storage."
    },
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key"
    },
    "client": {
      "apiUrlEnv": "HASNA_SWITCHER_API_URL",
      "apiKeyEnv": "HASNA_SWITCHER_API_KEY"
    }
  }
}
