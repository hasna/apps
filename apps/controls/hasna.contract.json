{
  "schema": "hasna.service_contract.v1",
  "name": "controls",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Spend-authorization/approval control plane over wallets+payments: per-entity/per-agent spend caps, counterparty allowlists, tiered human-approval thresholds, segregation-of-duties, emergency freeze, and an immutable hash-chained money audit. CLI + MCP + serve triad. Local mode uses SQLite at ~/.hasna/controls/controls.db; cloud mode (HASNA_CONTROLS_STORAGE_MODE=cloud) is PURE REMOTE per Amendment A1 with all reads/writes hitting the shared cloud Postgres.",
  "bins": [
    "controls",
    "controls-mcp",
    "controls-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "controls-api",
      "kind": "api",
      "status": "supported",
      "bin": "controls-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "controls-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "controls-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "controls-mcp",
      "authMode": "local-only"
    },
    {
      "name": "controls-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "controls",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CONTROLS_",
    "aliasEnvPrefix": "CONTROLS_",
    "sqlitePath": "~/.hasna/controls/controls.db",
    "pgTestGate": {
      "envVar": "HASNA_CONTROLS_TEST_DATABASE_URL",
      "command": "HASNA_CONTROLS_DATABASE_URL=\"${HASNA_CONTROLS_TEST_DATABASE_URL:?point it at a throwaway Postgres; the live-PG gate must not pass without one}\" HASNA_CONTROLS_REQUIRE_POSTGRES=1 bun test test/live-pg.test.ts"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
