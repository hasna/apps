{
  "$schema": "./node_modules/@hasna/contracts/src/hasna.contract.schema.json",
  "schema": "hasna.service_contract.v1",
  "name": "controls",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.13.3",
  "description": "Spend-authorization/approval control plane over wallets+payments: per-entity/per-agent spend caps, counterparty allowlists, tiered human-approval thresholds, segregation-of-duties, emergency freeze, and an immutable hash-chained money audit. CLI + MCP + serve triad. SQLite at ~/.hasna/controls/controls.db is authoritative unless HASNA_CONTROLS_DATABASE_URL is set, which selects the PostgreSQL backend.",
  "bins": [
    "controls",
    "controls-mcp",
    "controls-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "controls-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "package-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "controls-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "controls",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CONTROLS_",
    "aliasEnvPrefix": "CONTROLS_",
    "sqlitePath": "~/.hasna/controls/controls.db",
    "pgTestGate": {
      "envVar": "CONTROLS_TEST_DATABASE_URL",
      "command": "bun scripts/pg-test-gate.mjs"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
