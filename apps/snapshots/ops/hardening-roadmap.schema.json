{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hasna.com/schemas/snapshots-hardening-roadmap.schema.json",
  "title": "@hasna/snapshots hardening roadmap ledger",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "roadmap",
    "closurePolicy",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./hardening-roadmap.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "roadmap": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "closurePolicy": {
      "type": "object",
      "required": [
        "umbrellaKey",
        "workstreamKeys",
        "requiredEvidence",
        "machineValidation"
      ],
      "additionalProperties": false,
      "properties": {
        "umbrellaKey": {
          "const": "SNA-umbrella"
        },
        "workstreamKeys": {
          "const": [
            "SNA-00001",
            "SNA-00002",
            "SNA-00003",
            "SNA-00004",
            "SNA-00005",
            "SNA-00006",
            "SNA-00007",
            "SNA-00008",
            "SNA-00009",
            "SNA-00010",
            "SNA-00011",
            "SNA-00012",
            "SNA-00013",
            "SNA-00014",
            "SNA-00015",
            "SNA-00016"
          ]
        },
        "requiredEvidence": {
          "const": [
            "implementation",
            "tests",
            "docs",
            "machine011"
          ]
        },
        "machineValidation": {
          "type": "object",
          "required": [
            "machine",
            "minimumPositiveControls"
          ],
          "additionalProperties": false,
          "properties": {
            "machine": {
              "const": "machine011"
            },
            "minimumPositiveControls": {
              "const": 1
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "durableReference": {
      "type": "string",
      "pattern": "^(?:git:[0-9a-f]{40}:[A-Za-z0-9._/-]+(?:#L[1-9][0-9]*(?:-L[1-9][0-9]*)?)?|todos-attachment:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[A-Za-z0-9_-]{8,}:sha256:[0-9a-f]{64}:commit:[0-9a-f]{40})$"
    },
    "referenceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "reference": {
            "$ref": "#/$defs/durableReference"
          },
          "summary": {
            "type": "string",
            "minLength": 12,
            "pattern": "\\S"
          }
        }
      }
    },
    "positiveControl": {
      "type": "object",
      "required": [
        "name",
        "command",
        "exitStatus",
        "artifactReference"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        },
        "exitStatus": {
          "const": 0
        },
        "artifactReference": {
          "$ref": "#/$defs/durableReference"
        }
      }
    },
    "machineEvidence": {
      "type": "object",
      "required": [
        "machine",
        "commitSha",
        "command",
        "exitStatus",
        "timestamp",
        "artifactReference",
        "positiveControls"
      ],
      "additionalProperties": false,
      "properties": {
        "machine": {
          "const": "machine011"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        },
        "exitStatus": {
          "const": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "artifactReference": {
          "$ref": "#/$defs/durableReference"
        },
        "positiveControls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/positiveControl"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "key",
        "title",
        "dependsOn",
        "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^SNA-(?:umbrella|[0-9]{5})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "todosTaskId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "done"
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SNA-(?:umbrella|[0-9]{5})$"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^SNA-(?:umbrella|[0-9]{5})$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "implementation": {
              "$ref": "#/$defs/referenceEvidence"
            },
            "tests": {
              "$ref": "#/$defs/referenceEvidence"
            },
            "docs": {
              "$ref": "#/$defs/referenceEvidence"
            },
            "machine011": {
              "$ref": "#/$defs/machineEvidence"
            }
          }
        }
      }
    }
  }
}
