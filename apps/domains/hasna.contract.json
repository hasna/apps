{
  "schema": "hasna.service_contract.v1",
  "name": "domains",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.8.0",
  "description": "Domain portfolio, registrar, marketplace, and DNS management for AI agents through CLI, MCP, HTTP API, and SDK surfaces.",
  "bins": [
    "domains",
    "domains-mcp",
    "domains-serve"
  ],
  "deploymentModes": [
    "local",
    "self_hosted"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http",
      "kind": "api",
      "status": "supported",
      "bin": "domains-serve",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": false
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "domains-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json",
      "clientClassName": "DomainsClient"
    },
    {
      "name": "domains-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "domains-mcp",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    },
    {
      "name": "domains-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "domains",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    }
  ],
  "storage": {
    "mode": "local",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "envPrefix": "HASNA_DOMAINS_",
    "aliasEnvPrefix": "DOMAINS_",
    "sqlitePath": "~/.local/share/open-domains/domains.db",
    "pgTestGate": {
      "envVar": "HASNA_DOMAINS_TEST_DATABASE_URL",
      "command": "HASNA_DOMAINS_DATABASE_URL_OWNER=\"$HASNA_DOMAINS_TEST_DATABASE_URL\" bun run src/cli/index.ts db migrate --dry-run --json"
    }
  }
}
