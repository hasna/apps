{
  "schema": "hasna.service_contract.v1",
  "name": "domains",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.2",
  "description": "Domain portfolio, registrar, marketplace, DNS and hosted provisioning for AI agents. CLI, MCP and SDK clients resolve the owner credential and unversioned authority through @hasna/contracts, use https://api.hasna.com/domains with exactly one client-appended /v1, and fail closed when authentication is unavailable. Client SQLite/path selectors are retired and rejected. domains-serve and owner migrations use PostgreSQL selected by HASNA_DOMAINS_DATABASE_URL.",
  "bins": [
    "domains",
    "domains-mcp",
    "domains-serve"
  ],
  "storage": {
    "engines": [
      "postgresql"
    ],
    "envPrefix": "HASNA_DOMAINS_",
    "aliasEnvPrefix": "DOMAINS_",
    "backend": "postgresql",
    "pgTestGate": {
      "envVar": "HASNA_DOMAINS_TEST_DATABASE_URL",
      "command": "bun run test:postgres"
    }
  },
  "metadata": {
    "serve": {
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "containerPort": 8080,
      "auth": "api-key (@hasna/contracts) — header x-api-key or Authorization: Bearer",
      "scopes": [
        "domains:read",
        "domains:write",
        "domains:purchase"
      ],
      "signingKeyEnv": "HASNA_DOMAINS_API_SIGNING_KEY"
    },
    "sdk": {
      "export": "@hasna/domains/sdk",
      "client": "DomainsClient",
      "envUrl": "HASNA_DOMAINS_API_URL",
      "envKey": "HASNA_DOMAINS_API_KEY"
    },
    "release": {
      "artifactScan": {
        "script": "artifact-scan"
      }
    },
    "conformance": {
      "waivedAssetInventories": [
        {
          "kind": "domain",
          "reason": "Fixed third-party endpoints the CLI must contact to function: registrar/DNS APIs (godaddy, namecheap, cloudflare, sedo, brandsight), RDAP/IANA (iana.org), DNSBL check hosts (spamcop.net, sorbs.net, barracudacentral.org), and Cloudflare nameserver hosts. Product constants, not a bulk inventory.",
          "reviewedBy": "publish-all-domains",
          "expiresAt": "2026-11-21T00:00:00Z"
        },
        {
          "kind": "host",
          "reason": "Same fixed provider/check endpoints as the domain waiver (registrar APIs, RDAP, DNSBL hosts, Cloudflare NS hosts); each host is a required integration target, not an asset inventory.",
          "reviewedBy": "publish-all-domains",
          "expiresAt": "2026-11-21T00:00:00Z"
        }
      ]
    }
  },
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "domains-api",
      "kind": "api",
      "status": "supported",
      "bin": "domains-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "domains-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json",
      "clientClassName": "DomainsClient"
    },
    {
      "name": "domains-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "domains-mcp",
      "authMode": "api-key"
    },
    {
      "name": "domains-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "domains",
      "authMode": "api-key"
    }
  ]
}
