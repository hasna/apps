{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "sourceMap": false,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/testing-runner.ts", "src/testing.ts", "tests", "dist", "node_modules"]
}
