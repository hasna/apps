{
  "schema": "hasna.service_contract.v1",
  "name": "stations",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.13.1",
  "description": "Machine fleet control-plane: CLI + MCP + serve (HTTP /v1 registry API) + typed SDK. The data backend is the only runtime switch: SQLite at ~/.hasna/stations/stations.db by default, or PostgreSQL when a database URL is configured, in which case the serve process reads and writes PostgreSQL directly (PURE REMOTE — no sync engine). Every /v1 route requires an @hasna/contracts API key.",
  "bins": [
    "stations",
    "stations-mcp",
    "stations-serve",
    "stations-daemon"
  ],
  "serviceSurfaces": [
    {
      "name": "stations-api",
      "kind": "api",
      "status": "supported",
      "bin": "stations-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "stations-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "stations-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "stations",
      "authMode": "local-only"
    },
    {
      "name": "stations-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "stations-mcp",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_STATIONS_",
    "aliasEnvPrefix": "STATIONS_",
    "sqlitePath": "~/.hasna/stations/stations.db",
    "pgTestGate": {
      "envVar": "HASNA_STATIONS_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "serve": {
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiBase": "/v1",
      "authHeader": "x-api-key",
      "scopes": [
        "stations:read",
        "stations:write"
      ]
    },
    "client": {
      "apiUrlEnv": "STATIONS_API_URL",
      "apiKeyEnv": "STATIONS_API_KEY"
    },
    "release": {
      "artifactScan": {
        "script": "verify:pack"
      }
    }
  }
}
