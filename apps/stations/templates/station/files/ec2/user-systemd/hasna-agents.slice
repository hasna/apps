# hasna station template v1 (ec2 overlay, 32G Graviton station).
# Scaled from the dgx-spark values (54G/60G on 121G) to a 32G box: agents may
# use up to 24G hard / 20G soft, leaving ~8G for OS, page cache and the hq seat.
[Unit]
Description=Hasna bounded agent worker slice

[Slice]
MemoryAccounting=yes
MemoryHigh=20G
MemoryMax=24G
MemorySwapMax=0
TasksAccounting=yes
TasksMax=16384
