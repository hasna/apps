# hasna station template v1 (dgx-spark overlay, 121G box).
# The slice existed on Jul 28 2026 but nothing ran inside it — agents launched
# into tmux panes in the session scope, so the cap was decoration. The roster
# reconciler (station contract §6.4) launches agents into this slice.
[Unit]
Description=Hasna bounded agent worker slice

[Slice]
MemoryAccounting=yes
MemoryHigh=54G
MemoryMax=60G
MemorySwapMax=0
TasksAccounting=yes
TasksMax=16384
