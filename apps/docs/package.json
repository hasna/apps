{
  "name": "@hasna/docs",
  "version": "0.1.0",
  "description": "Headless rich-text document SDK over the ProseMirror/TipTap JSON model — create/edit documents, import/export Markdown, HTML, and JSON, extract outlines and word counts, plus a TipTap-based React <Editor>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docs": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "docs/*.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:lib && bun run build:react && bun run build:cli && bun run build:types",
    "build:lib": "bun build src/index.ts --outdir dist --target node",
    "build:react": "NODE_ENV=production bun build src/react/index.ts --outdir dist/react --target browser --external react --external react-dom --external 'react/jsx-runtime' --external 'react/jsx-dev-runtime' --external '@tiptap/*'",
    "build:cli": "bun build src/cli/index.ts --outdir dist/cli --target node --external commander --external chalk",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "build:dashboard": "cd dashboard && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:cli": "bun run src/cli/index.ts",
    "prepack": "bun run build && bun run scan:artifact",
    "prepublishOnly": "bun run typecheck && bun test",
    "scan:artifact": "bun scripts/scan-artifact.ts"
  },
  "keywords": [
    "docs",
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "markdown",
    "html",
    "wysiwyg",
    "react",
    "sdk",
    "hasna"
  ],
  "author": "hasna",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/docs.git"
  },
  "homepage": "https://github.com/hasna/docs",
  "bugs": {
    "url": "https://github.com/hasna/docs/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-link": "3.27.1",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "optionalDependencies": {
    "@tiptap/extension-bubble-menu": "3.27.1",
    "@tiptap/extension-floating-menu": "3.27.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.4",
    "typescript": "^5.7.3",
    "bun-types": "1.3.14",
    "@hasna/contracts": "0.11.1"
  }
}
