{
  "schema": "hasna.service_contract.v1",
  "name": "calendar",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.14.2",
  "description": "Universal calendar management for AI coding agents. CLI + MCP + HTTP API (calendar-serve) + generated SDK. The server's data backend is selected by configuration: HASNA_CALENDAR_DATABASE_URL present selects postgresql, otherwise sqlite. On postgresql the serve process reads/writes that database directly with API-key auth via @hasna/contracts. The client connects to its local SQLite file or to the /v1 authority over HTTP (HASNA_CALENDAR_API_URL + HASNA_CALENDAR_API_KEY), and never opens Postgres directly.",
  "bins": [
    "calendar",
    "calendar-mcp",
    "calendar-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "calendar-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "calendar-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "calendar",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CALENDAR_",
    "aliasEnvPrefix": "CALENDAR_",
    "sqlitePath": "~/.hasna/calendar/calendar.db",
    "pgTestGate": {
      "envVar": "CALENDAR_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "service": {
      "port": 19428,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key"
    },
    "client": {
      "apiUrlEnv": "CALENDAR_API_URL",
      "apiKeyEnv": "CALENDAR_API_KEY"
    }
  }
}
