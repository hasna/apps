{
  "schema": "hasna.service_contract.v1",
  "name": "calendar",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Partial Calendar domain migration: authenticated explicit HTTPS clients and PostgreSQL-only server. Embedded Events/channel/replay remain unresolved local integrations; explicit legacy db-migrate is LOCAL-ONLY and refused in api mode (no local database is created when HASNA_CALENDAR_API_URL is set).",
  "bins": [
    "calendar",
    "calendar-mcp",
    "calendar-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "calendar-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "calendar-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "calendar",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "postgresql"
    ],
    "envPrefix": "HASNA_CALENDAR_",
    "aliasEnvPrefix": "CALENDAR_",
    "pgTestGate": {
      "envVar": "CALENDAR_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "service": {
      "port": 19428,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key"
    },
    "client": {
      "apiUrlEnv": "HASNA_CALENDAR_API_URL",
      "apiKeyEnv": "HASNA_CALENDAR_API_KEY"
    },
    "migration": {
      "status": "partial",
      "unresolved": [
        "embedded Events/channel/replay"
      ],
      "sharedCanonicalContracts": "unpublished"
    }
  }
}
