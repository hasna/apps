{
  "$schema": "https://github.com/hasna/contracts/schema/hasna.service_contract.v1.json",
  "schema": "hasna.service_contract.v1",
  "name": "sessions",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Search and sync AI coding sessions (Claude, Codex, Codewith, Gemini). Client: local SQLite at ~/.hasna/sessions/sessions.db, or the hosted HTTP API selected by HASNA_SESSIONS_API_URL + HASNA_SESSIONS_API_KEY. Server: HASNA_SESSIONS_DATABASE_URL selects PostgreSQL, else SQLite. sessions-serve reads/writes the active backend directly for session metadata, imported messages, and tool calls via /v1 including /v1/sessions/import.",
  "bins": [
    "sessions",
    "sessions-mcp",
    "sessions-serve"
  ],
  "serviceSurfaces": [
    {
      "name": "http",
      "status": "supported",
      "bin": "sessions-serve",
      "mcpBin": "sessions-mcp",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    }
  ],
  "storage": {
    "envPrefix": "HASNA_SESSIONS_",
    "aliasEnvPrefix": "SESSIONS_",
    "databaseUrlSecretRef": "hasna/oss/sessions/database-url",
    "sqlitePath": "~/.hasna/sessions/sessions.db",
    "backend": "sqlite"
  },
  "metadata": {
    "serve": {
      "healthEndpoints": [
        "/health",
        "/ready",
        "/version"
      ],
      "versionedApiPrefix": "/v1",
      "openapi": "/openapi.json",
      "auth": "api-key (@hasna/contracts/auth)"
    },
    "objectStore": {
      "provider": "s3",
      "status": "optional",
      "objectKind": "normalized_content",
      "bucketEnv": "HASNA_SESSIONS_S3_BUCKET",
      "regionEnv": "HASNA_SESSIONS_S3_REGION",
      "endpointEnv": "HASNA_SESSIONS_S3_ENDPOINT",
      "prefixEnv": "HASNA_SESSIONS_S3_PREFIX",
      "accessKeyIdSecretEnv": "HASNA_SESSIONS_S3_ACCESS_KEY_ID",
      "secretAccessKeySecretEnv": "HASNA_SESSIONS_S3_SECRET_ACCESS_KEY"
    },
    "sessionSources": [
      "claude",
      "codex",
      "codewith",
      "gemini"
    ]
  }
}
