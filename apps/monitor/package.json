{
  "name": "@hasna/monitor",
  "version": "0.1.29",
  "description": "System monitoring tool for multiple computers \u2014 local, SSH, EC2",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/monitor.git"
  },
  "homepage": "https://github.com/hasna/monitor#readme",
  "bugs": {
    "url": "https://github.com/hasna/monitor/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bin": {
    "monitor": "./bins/monitor.js",
    "monitor-mcp": "./bins/monitor-mcp.js",
    "monitor-daemon": "./bins/monitor-daemon.js",
    "monitor-server": "./bins/monitor-server.js",
    "monitor-web": "./bins/monitor-web.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun --external cpu-features --external @aws-sdk/* --external node-ssh --external ssh2 --external node-cron",
    "contract-check": "bunx @hasna/contracts@0.11.1 repo-conformance .",
    "contract-baseline": "bun scripts/contract-baseline.ts",
    "contract-gate": "bun scripts/contract-gate.ts --online",
    "scan:artifact": "bun scripts/scan-artifact.ts",
    "prepack": "bun run scan:artifact",
    "postinstall": "bun ./scripts/ensure-data-dir.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx tsc --noEmit",
    "monitor": "bun run ./bins/monitor.ts",
    "monitor-mcp": "bun run ./bins/monitor-mcp.ts",
    "monitor-server": "bun run ./bins/monitor-server.ts",
    "monitor-web": "bun run ./bins/monitor-web.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.600.0",
    "@aws-sdk/client-ec2": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.1017.0",
    "@hasna/events": "^0.1.16",
    "@hasna/hooks": "^0.7.0",
    "@hasna/skills": "0.1.59",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "node-cron": "^3.0.3",
    "node-ssh": "^13.2.0",
    "postgres": "^3.4.8",
    "systeminformation": "5.33.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.4.5"
  }
}
