{
  "schema": "hasna.service_contract.v1",
  "name": "accounts",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.10.6",
  "description": "Manage and switch between multiple AI coding tool profiles/accounts. The client uses the local registry at ~/.hasna/accounts/accounts.json, or the HTTP API selected by HASNA_ACCOUNTS_API_URL + HASNA_ACCOUNTS_API_KEY. The accounts-serve server data backend is postgresql when HASNA_ACCOUNTS_DATABASE_URL is set.",
  "bins": [
    "accounts",
    "accounts-mcp",
    "accounts-serve",
    "accounts-migrate"
  ],
  "serviceSurfaces": [
    {
      "name": "accounts-api",
      "status": "supported",
      "bin": "accounts-serve",
      "mcpBin": "accounts-mcp",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "readinessGates": [
        {
          "id": "accounts-migrations",
          "kind": "migration",
          "required": true,
          "command": "accounts-migrate",
          "status": "pending"
        }
      ],
      "openApiPath": "/openapi.json"
    },
    {
      "name": "accounts-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "accounts-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "accounts",
      "authMode": "none"
    }
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "json",
      "postgresql"
    ],
    "envPrefix": "HASNA_ACCOUNTS_",
    "aliasEnvPrefix": "ACCOUNTS_",
    "pgTestGate": {
      "envVar": "HASNA_ACCOUNTS_TEST_DATABASE_URL",
      "command": "bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "verify:pack"
      }
    }
  }
}
