region                   = "us-east-1"
stage                    = "prod"
service_name             = "open-uptime"
project_name             = "open-uptime"
owner                    = "hasna"
app_type                 = "opensource"
environment              = "prod"
cost_center              = "opensource"
hostname                 = "uptime.example.com"
workspace_id             = "workspace-id"
vpc_id                   = "vpc-xxxxxxxx"
ecr_repository_name      = "open-uptime"
protected_access_mode    = "cloudfront_default_domain"
cloudfront_origin_protocol_policy = "http-only"
allow_cloudfront_http_origin_live_traffic = false
cloudfront_origin_domain_name     = null
enable_cloudfront_origin_verify_header = false
cloudfront_origin_verify_header_name   = "X-Open-Uptime-Origin-Verify"
cloudfront_origin_verify_header_value  = null
allow_origin_verify_header_before_backend_state_hardened = false
public_subnet_ids        = ["subnet-replace-public-a", "subnet-replace-public-b"]
alb_ingress_cidr_blocks = []
private_subnet_ids       = ["subnet-replace-private-a", "subnet-replace-private-b"]
private_route_table_ids  = ["rtb-replace-private"]
container_image          = "<ecr-image-uri-or-digest>"
runtime_package_version   = "0.1.70"
runtime_package_integrity = null
allow_unpinned_runtime_package_integrity = false
certificate_arn          = null
hosted_zone_id           = null
app_env_secret_arn       = "<app-env-secret-arn>"
hosted_token_secret_arn  = "<hosted-token-secret-arn>"
public_probe_secret_arn  = "<public-probe-secret-arn>"
reporting_secret_arn     = "<reporting-secret-arn>"
kms_key_arn              = "<kms-key-arn>"
alarm_actions            = []
enable_worker_runtime_alarms = false
worker_runtime_metric_producers_ready = false
worker_runtime_alarm_namespace = "OpenUptime/Worker"
monthly_budget_limit_usd = 0
enable_nat_task_egress = false
enable_private_vpc_endpoints = false
additional_vpc_endpoint_source_security_group_ids = []
additional_vpc_endpoint_principal_arns = {
  ecr         = []
  logs        = []
  secret_read = []
  sts         = []
  kms         = []
  s3_evidence = []
}
backup_retention_days = 35
backup_vault_lock_mode = "disabled"
backup_vault_lock_min_retention_days = 35
backup_vault_lock_max_retention_days = 3650
backup_vault_lock_changeable_for_days = null

desired_counts = {
  web            = 0
  scheduler      = 0
  "public-probe" = 0
  reporter       = 0
  migration      = 0
}

live_ops_backend_state_hardened     = false
live_ops_human_alert_delivery_ready = false
live_ops_backup_restore_ready       = false
live_ops_evidence_retention_ready   = false

budget_alert_email_addresses = []
