{
  "schema": "hasna.service_contract.v1",
  "name": "economy",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "AI coding cost tracker — CLI + MCP + HTTP API (economy-serve) + generated SDK. The server data backend is sqlite | postgresql, selected by the presence of HASNA_ECONOMY_DATABASE_URL; with postgresql the serve process reads AND writes the shared PostgreSQL directly with API-key auth via @hasna/contracts.",
  "bins": ["economy", "economy-mcp", "economy-serve"],
  "hosting": ["user-hosted"],
  "serviceSurfaces": [
    {
      "name": "economy-api",
      "kind": "api",
      "status": "supported",
      "bin": "economy-serve",
      "authMode": "api-key",
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json",
      "health": { "method": "GET", "path": "/health", "public": true },
      "readiness": { "method": "GET", "path": "/ready", "public": true },
      "version": { "method": "GET", "path": "/version", "public": true }
    },
    {
      "name": "economy-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "economy-mcp",
      "authMode": "local-only"
    },
    {
      "name": "economy-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "economy",
      "authMode": "local-only"
    },
    {
      "name": "economy-sdk",
      "kind": "sdk",
      "status": "deferred",
      "authMode": "api-key",
      "generatedFrom": "/openapi.json",
      "clientClassName": "EconomyClient",
      "deferReason": "The generated SDK ships as the sibling package @hasna/economy-sdk, not as an export subpath of @hasna/economy. The v1 contract models SDK surfaces only as exportSubpath of the same package, so this surface cannot yet be declared supported without a false exportSubpath."
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": ["sqlite", "postgresql"],
    "envPrefix": "HASNA_ECONOMY_",
    "aliasEnvPrefix": "ECONOMY_",
    "databaseUrlSecretRef": "hasna/oss/economy/database-url",
    "sqlitePath": "~/.hasna/economy/economy.db"
  },
  "metadata": {
    "service": {
      "port": 8787,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretSecretRef": "hasna/oss/economy/api-key-signing-secret"
    },
    "client": {
      "apiUrlEnv": "ECONOMY_API_URL",
      "apiKeyEnv": "ECONOMY_API_KEY"
    }
  }
}
