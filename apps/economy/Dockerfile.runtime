# Runtime-only image for the economy self_hosted serve, assembled from
# host-built artifacts (dist + node_modules) rather than installing in the build
# context. The serve bundle only needs @hasna/contracts and pg at runtime, both
# present in the host node_modules; host and target are both linux/arm64 so the
# artifacts are binary-compatible.
#
# (Historical note: this image originally existed because @hasna/agent-registry
# and @hasna/mcp-harness were unpublished `file:` sibling deps that
# `bun install --frozen-lockfile` could not resolve in an isolated context. Both
# are now resolved from the registry, so the standard multi-stage Dockerfile is
# viable again; switching over is deliberately left to a separate change.)
FROM --platform=linux/arm64 oven/bun:1 AS runner
WORKDIR /app
COPY docker/rds-global-bundle.pem /etc/ssl/certs/rds-global-bundle.pem
ENV NODE_ENV=production \
    HASNA_ECONOMY_STORAGE_MODE=cloud \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem \
    PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem \
    ECONOMY_HOST=0.0.0.0 \
    ECONOMY_PORT=8787
COPY package.json bun.lock ./
COPY node_modules ./node_modules
COPY dist ./dist
EXPOSE 8787
CMD ["bun", "dist/server/index.js", "--port", "8787"]
