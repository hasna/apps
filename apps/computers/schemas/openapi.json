    "/ready": { "get": { "security": [], "operationId": "ready", "x-error-codes-by-status": { "403": ["authorization_denied"], "500": ["storage_error"], "503": ["storage_error"] }, "responses": { "200": { "description": "SQLite core ready" }, "403": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
