  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" } },
    "parameters": {
      "ComputerId": { "in": "path", "name": "computerId", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "IdempotencyKeyOptional": { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "$ref": "#/components/schemas/IdempotencyKey" } }
    },
    "requestBodies": { "IdempotentLifecycle": { "required": false, "description": "Optional when Idempotency-Key is supplied as a header.", "content": { "application/json": { "schema": { "type": "object", "properties": { "idempotencyKey": { "$ref": "#/components/schemas/IdempotencyKey" } }, "additionalProperties": false } } } } },
