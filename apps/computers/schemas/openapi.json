    "/v1/computers/{computerId}/stop": { "post": { "operationId": "requestStop", "parameters": [{ "$ref": "#/components/parameters/ComputerId" }, { "$ref": "#/components/parameters/IdempotencyKeyOptional" }], "x-idempotency-key": { "headerOrBody": true }, "x-error-codes-by-status": { "400": ["invalid_request"], "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "409": ["conflict"], "413": ["request_too_large"], "500": ["storage_error"] }, "requestBody": { "$ref": "#/components/requestBodies/IdempotentLifecycle" }, "responses": { "202": { "$ref": "#/components/responses/PendingOperation" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } } } },
    "/v1/computers/{computerId}/quarantine": { "post": { "operationId": "requestQuarantine", "parameters": [{ "$ref": "#/components/parameters/ComputerId" }, { "$ref": "#/components/parameters/IdempotencyKeyOptional" }], "x-idempotency-key": { "headerOrBody": true }, "x-error-codes-by-status": { "400": ["invalid_request"], "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "409": ["conflict"], "413": ["request_too_large"], "500": ["storage_error"] }, "requestBody": { "$ref": "#/components/requestBodies/IdempotentLifecycle" }, "responses": { "202": { "$ref": "#/components/responses/PendingOperation" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } } } },
