    },
    "schemas": {
      "Id": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{2,63}$" },
      "CustomProfileId": { "allOf": [{ "$ref": "#/components/schemas/Id" }], "not": { "enum": ["profile_default", "profile_adopted"] } },
      "IdempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
