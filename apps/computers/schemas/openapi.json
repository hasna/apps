      "post": { "operationId": "createInstallPolicy", "parameters": [{ "$ref": "#/components/parameters/ComputerId" }], "x-error-codes-by-status": { "400": ["invalid_request"], "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "409": ["conflict", "policy_generation_mismatch"], "413": ["request_too_large"], "500": ["storage_error"] }, "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["rules"], "properties": { "rules": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/components/schemas/InstallPolicyRule" } } }, "additionalProperties": false } } } }, "responses": { "201": { "description": "Immutable revision created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstallPolicyRevision" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/computers/{computerId}/snapshots": { "get": { "operationId": "listSnapshots", "parameters": [{ "$ref": "#/components/parameters/ComputerId" }], "x-error-codes-by-status": { "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "500": ["storage_error"] }, "responses": { "200": { "description": "Snapshot list" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createSnapshot", "parameters": [{ "$ref": "#/components/parameters/ComputerId" }], "x-error-codes-by-status": { "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "500": ["storage_error"], "503": ["provider_not_configured"] }, "responses": { "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/operations": { "get": { "operationId": "listOperations", "parameters": [{ "in": "query", "name": "computerId", "schema": { "$ref": "#/components/schemas/Id" } }], "x-error-codes-by-status": { "400": ["invalid_request"], "401": ["authentication_required"], "403": ["authorization_denied", "policy_generation_mismatch"], "404": ["not_found"], "500": ["storage_error"] }, "responses": { "200": { "description": "Authorized operations", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Operation" } } }, "additionalProperties": false } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } } } },
