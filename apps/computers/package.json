{
  "name": "@hasna/computers",
  "version": "0.1.0",
  "description": "Durable lifetime computers for AI employees",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Hasna",
  "homepage": "https://github.com/hasna/computers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/computers.git"
  },
  "bugs": {
    "url": "https://github.com/hasna/computers/issues"
  },
  "keywords": [
    "computers",
    "device-management",
    "ai-agents",
    "bun",
    "sqlite",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "bin": {
    "computers": "./dist/bin/computers.js",
    "computers-serve": "./dist/bin/computers-serve.js",
    "computers-mcp": "./dist/bin/computers-mcp.js",
    "computers-worker": "./dist/bin/computers-worker.js",
    "computers-resident": "./dist/bin/computers-resident.js",
    "computers-migrate": "./dist/bin/computers-migrate.js"
  },
  "files": [
    "dist",
    "docs",
    "migrations",
    "schemas",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run scripts/build.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bun run scripts/check-source.ts",
    "check:schemas": "bun run scripts/check-schemas.ts",
    "check:surfaces": "bun run scripts/check-surfaces.ts",
    "check": "bun run typecheck && bun test && bun run lint && bun run check:schemas && bun run check:surfaces && bun run build",
    "verify:pack": "bun run scripts/verify-pack.ts",
    "verify:release": "bun run check && bun run verify:pack && bun audit && bun pm untrusted",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
