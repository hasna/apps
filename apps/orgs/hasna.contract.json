{
  "schema": "hasna.service_contract.v1",
  "name": "orgs",
  "class": "library",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Open organization graph and delegation-context layer for agentic systems.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "orgs"
  ],
  "serviceSurfaces": [
    {
      "name": "orgs-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "orgs",
      "authMode": "local-only"
    },
    {
      "name": "orgs-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": "."
    }
  ],
  "metadata": {
    "conformance": {
      "waivedSurfaces": [
        {
          "kind": "api",
          "reason": "Library package with no HTTP service boundary; no serve bin ships."
        },
        {
          "kind": "mcp",
          "reason": "Library package with no MCP server bin; MCP execution belongs to consumers."
        }
      ]
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
