{
  "schema": "hasna.service_contract.v1",
  "name": "actions",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Local-first action manifests, runs, and audit events exposed through CLI, MCP, and SDK surfaces. SQLite at ~/.hasna/actions/actions.db by default (resolved via @hasna/paths; the XDG data home is adopted only once the store is migrated there or HASNA_DATA_HOME is set).",
  "bins": [
    "actions",
    "actions-mcp"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "actions-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "actions",
      "authMode": "local-only"
    },
    {
      "name": "actions-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "actions-mcp",
      "authMode": "local-only"
    },
    {
      "name": "actions-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": "./sdk"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite"
    ],
    "sqlitePath": "~/.hasna/actions/actions.db"
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "conformance": {
      "waivedStorageEngines": [
        {
          "engine": "postgresql",
          "reason": "Local-only CLI and stdio MCP package with no service bin, cloud placement, or managed SaaS runtime."
        }
      ]
    }
  }
}
