{
  "manifest_version": 3,
  "name": "@hasna/browser Bridge",
  "version": "0.5.34",
  "description": "Runs explicit @hasna/browser automation jobs inside this Chrome session.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "@hasna/browser",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon-32.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
