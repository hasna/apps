"{
  "name": "knowledge-refresh-loops-runbooks-worker-verifier",
  "description": "Bounded worker/verifier workflow for Refresh and verify loops runbooks.",
  "version": 1,
  "steps": [
    {
      "id": "worker",
      "name": "Worker",
      "description": "Execute the bounded objective and record evidence.",
      "target": {
        "type": "agent",
        "provider": "codewith",
        "prompt": "/goal Refresh and verify loops runbooks.\\nYou are the worker step for a bounded OpenLoops agent workflow.\\nOpenLoops worktree policy:\\n- Worktree mode off did not select an isolated worktree: worktree mode disabled.\\n- Cwd: <REPO>\\n- Do not create ad hoc worktrees unless the task itself explicitly requires one.\\nInvestigate first. Keep scope narrow, use local project/task systems as the source of truth when relevant, preserve unrelated changes, run focused validation, and record concise evidence.\\nDo not dispatch or paste prompts into tmux panes. If additional work is required, create or update deduped todos tasks so task-created routing can start a fresh headless workflow.\\nInspect recent knowledge records, improve structure/schema where appropriate, avoid duplicates, create tasks for code changes instead of doing unrelated implementation, and record verification evidence.",
        "cwd": "<REPO>",
        "configIsolation": "safe",
        "permissionMode": "bypass",
        "sandbox": "workspace-write",
        "worktree": {
          "mode": "off",
          "enabled": false,
          "originalCwd": "<REPO>",
          "cwd": "<REPO>",
          "reason": "worktree mode disabled"
        },
        "routing": {
          "projectPath": "<REPO>",
          "role": "worker"
        },
        "timeoutMs": null
      },
      "timeoutMs": null
    },
    {
      "id": "verifier",
      "name": "Verifier",
      "description": "Adversarially verify the bounded objective result.",
      "dependsOn": [
        "worker"
      ],
      "target": {
        "type": "agent",
        "provider": "codewith",
        "prompt": "/goal Adversarially verify: Refresh and verify loops runbooks.\\n\\nYou are the verifier step for a bounded OpenLoops agent workflow.\\nOpenLoops worktree policy:\\n- Worktree mode off did not select an isolated worktree: worktree mode disabled.\\n- Cwd: <REPO>\\n- Do not create ad hoc worktrees unless the task itself explicitly requires one.\\nUse fresh context. Review the worker result for correctness, regressions, missing tests, safety, runaway-agent risk, output bounds, and incomplete evidence.\\nVerifier runtime contract:\\n- OpenLoops will mark this verifier timed_out after 900000ms without stdout/stderr. Emit a concise heartbeat/progress line before long checks.\\n- Keep final evidence compact: summarize changed files, validation commands/results, findings, and the task decision instead of pasting bulky logs.\\n- If validation cannot finish, record a clear blocked/failed task comment with the last completed check and the next concrete action.\\nIf valid, record verification evidence. If invalid, create precise follow-up tasks or comments and leave the original work open. Do not make broad unrelated changes.",
        "cwd": "<REPO>",
        "configIsolation": "safe",
        "permissionMode": "bypass",
        "sandbox": "workspace-write",
        "worktree": {
          "mode": "off",
          "enabled": false,
          "originalCwd": "<REPO>",
          "cwd": "<REPO>",
          "reason": "worktree mode disabled"
        },
        "routing": {
          "projectPath": "<REPO>",
          "role": "verifier"
        },
        "timeoutMs": null,
        "idleTimeoutMs": 900000
      },
      "timeoutMs": null
    }
  ]
}"
`;

