    }
  },
  {
    "name": "loop_create_command",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique loop name."
        },
        "description": {
          "type": "string",
          "description": "Why/how/outcome description; a default is generated when omitted."
        },
        "schedule": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "once"
                },
                "at": {
                  "type": "string",
                  "description": "Absolute date/time parseable by JavaScript Date (ISO 8601 recommended)."
                }
              },
              "required": [
                "type",
                "at"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "interval"
                },
                "everyMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "description": "Interval between runs in milliseconds."
                },
                "anchor": {
                  "type": "string",
                  "enum": [
                    "fixed_rate",
                    "fixed_delay"
                  ],
                  "description": "fixed_rate anchors slots to the original cadence; fixed_delay measures from the previous finish."
                }
              },
              "required": [
                "type",
                "everyMs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "cron"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "description": "5-field cron expression evaluated in local time."
                }
              },
              "required": [
                "type",
                "expression"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "dynamic"
                },
                "minIntervalMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "description": "Minimum spacing between runs in milliseconds."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ],
          "description": "When the loop runs."
        },
        "timeoutMs": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-run timeout in milliseconds; null disables the timeout."
        },
        "catchUp": {
          "type": "string",
          "enum": [
            "none",
            "latest",
            "all"
          ],
          "description": "Missed-slot policy after downtime: none skips them, latest replays the newest slot, all replays every slot."
        },
        "catchUpLimit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Maximum missed slots replayed when catching up."
        },
        "overlap": {
          "type": "string",
          "enum": [
            "skip",
            "allow"
          ],
          "description": "Behavior when a slot comes due while a previous run is active: skip records a skipped run, allow runs concurrently."
        },
        "maxAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Attempts per slot before a failed run is final (default 1)."
        },
        "retryDelayMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Base retry delay in milliseconds (exponential backoff with jitter)."
        },
        "leaseMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Run lease in milliseconds before an unresponsive runner is considered dead."
        },
        "expiresAt": {
          "type": "string",
          "description": "Date/time after which the loop expires and stops scheduling."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Executable to run (resolved via PATH); not a shell string."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Argv-style arguments passed to the command."
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for the command."
        },
        "shell": {
          "not": {},
          "description": "Not supported over MCP: shell execution is rejected. Use 'command' plus 'args' instead."
        }
      },
      "required": [
        "name",
        "schedule",
        "command"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
