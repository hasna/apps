{
  "$schema": "./node_modules/@hasna/contracts/dist/hasna.contract.schema.json",
  "schema": "hasna.service_contract.v1",
  "name": "loops",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Persistent loop and workflow runner for deterministic commands and headless AI coding agents. CLI + MCP + HTTP API (loops-serve) + generated SDK. The only technical switch is the server data backend: sqlite (zero-config on-box default) or postgresql, selected by HASNA_LOOPS_DATABASE_URL. Clients use a local SQLite file or the server HTTP API. Local state lives at the effective Loops data home (~/.hasna/loops by default, resolved via @hasna/paths; the XDG data home is adopted only once the store is migrated there or HASNA_DATA_HOME is set).",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "loops",
    "loops-mcp",
    "loops-serve",
    "loops-daemon",
    "loops-runner"
  ],
  "serviceSurfaces": [
    {
      "name": "http",
      "kind": "api",
      "status": "supported",
      "bin": "loops-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json",
      "readinessGates": [
        {
          "id": "api-key-auth-negative",
          "kind": "auth",
          "required": true,
          "command": "bun test src/api/index.test.ts src/lib/auth/tenant-auth.test.ts",
          "status": "passed",
          "summary": "Protected /v1 routes fail closed without valid tenant-bound API-key authorization."
        },
        {
          "id": "control-plane-readiness",
          "kind": "readiness",
          "required": true,
          "command": "bun test src/api/index.test.ts src/serve/index.test.ts",
          "status": "passed",
          "summary": "Public readiness reports stable storage, auth, and migration codes without credential details."
        }
      ]
    },
    {
      "name": "sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json",
      "clientClassName": "LoopsClient"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "authMode": "local-only",
      "mcpBin": "loops-mcp"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "authMode": "local-only",
      "bin": "loops"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_LOOPS_",
    "sqlitePath": "~/.hasna/loops/loops.db",
    "pgTestGate": {
      "envVar": "LOOPS_TEST_DATABASE_URL",
      "command": "bun test src/lib/storage/postgres-loop-storage.test.ts"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "check:packed:scan"
      }
    },
    "service": {
      "port": 8787,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "aws": {
        "minimumDesiredCount": 2,
        "minimumAvailabilityZones": 2,
        "capacityProviderBase": "FARGATE:1",
        "healthCheckPath": "/ready",
        "requiresAlarmActions": true,
        "requiresKmsEncryptedLogs": true,
        "requiresSecretRotation": true
      }
    },
    "client": {
      "apiUrlEnv": "HASNA_LOOPS_API_URL",
      "apiKeyEnv": "HASNA_LOOPS_API_KEY"
    }
  }
}
