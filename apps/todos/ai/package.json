{
  "name": "@hasna/todos-ai",
  "version": "0.1.3",
  "description": "Optional provider-neutral AI runtime companion for @hasna/todos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation.d.ts",
      "import": "./dist/evaluation.js"
    },
    "./groq": {
      "types": "./dist/providers/groq.d.ts",
      "import": "./dist/providers/groq.js"
    },
    "./smoke": {
      "types": "./dist/smoke.d.ts",
      "import": "./dist/smoke.js"
    }
  },
  "bin": {
    "todos-ai-groq-smoke": "dist/smoke.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist .tmp/types && bun build src/index.ts src/runtime.ts src/evaluation.ts src/providers/groq.ts src/smoke.ts --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json && cp -R .tmp/types/ai/src/. dist/ && rm -rf .tmp/types",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:release-review": "bun run ../scripts/verify-npm-release-agent-review.ts",
    "prepublishOnly": "bun run ../scripts/verify-npm-release-agent-review.ts",
    "smoke:groq": "bun run src/smoke.ts"
  },
  "keywords": [
    "todos",
    "ai",
    "agent",
    "groq",
    "ai-sdk",
    "runtime"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hasna/todos.git",
    "directory": "ai"
  },
  "homepage": "https://github.com/hasna/todos/tree/main/ai",
  "bugs": {
    "url": "https://github.com/hasna/todos/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "author": "Andrei Hasna <andrei@hasna.com>",
  "license": "Apache-2.0",
  "sideEffects": false,
  "peerDependencies": {
    "@hasna/todos": ">=0.15.24 <1"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.0",
    "ai": "^7.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.7.3"
  }
}
