{
  "schema": "hasna.service_contract.v1",
  "name": "tenants",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Hasna fleet tenant auth / IdP: tenants, users, memberships, service principals, sessions, OTP login front door, and asymmetric-key auth.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "tenants",
    "tenants-serve",
    "tenants-mcp"
  ],
  "serviceSurfaces": [
    {
      "name": "tenants-api",
      "kind": "api",
      "status": "supported",
      "bin": "tenants-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true,
        "description": "Liveness: { status, version, backend }"
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true,
        "description": "Readiness: DB reachable + migrated (503 when degraded)"
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true,
        "description": "Version: { status, version, backend }"
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "tenants-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "tenants-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "tenants",
      "authMode": "local-only"
    },
    {
      "name": "tenants-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "tenants-mcp",
      "authMode": "api-key"
    }
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_TENANTS_",
    "aliasEnvPrefix": "TENANTS_",
    "pgTestGate": {
      "envVar": "HASNA_TENANTS_TEST_DATABASE_URL",
      "command": "HASNA_TENANTS_DATABASE_URL=$HASNA_TENANTS_TEST_DATABASE_URL bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "check:artifact"
      }
    }
  }
}
