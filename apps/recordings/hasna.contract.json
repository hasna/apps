{
  "schema": "hasna.service_contract.v1",
  "name": "recordings",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Speech-to-text recording store for AI coding agents. CLI + MCP + HTTP API (recordings-serve) + generated SDK. The server's data backend is selected by the environment: a HASNA_RECORDINGS_DATABASE_URL selects postgresql, anything else serves from sqlite; on postgresql the serve process reads/writes that database directly with API-key auth via @hasna/contracts. The client has exactly two stores — on-box sqlite, or the server's /v1 HTTP API selected by the presence of both HASNA_RECORDINGS_API_URL and HASNA_RECORDINGS_API_KEY — and never opens Postgres.",
  "bins": [
    "recordings",
    "recordings-mcp",
    "recordings-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "recordings-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "recordings-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "recordings",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_RECORDINGS_",
    "aliasEnvPrefix": "RECORDINGS_",
    "sqlitePath": "~/.hasna/recordings/recordings.db",
    "pgTestGate": {
      "envVar": "RECORDINGS_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "service": {
      "port": 8874,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key"
    },
    "client": {
      "apiUrlEnv": "RECORDINGS_API_URL",
      "apiKeyEnv": "RECORDINGS_API_KEY"
    }
  }
}
