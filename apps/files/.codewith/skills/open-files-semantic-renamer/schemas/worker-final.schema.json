{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "jobs_seen",
    "proposals_written",
    "needs_review",
    "errors"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "partial", "failed"]
    },
    "jobs_seen": {
      "type": "integer",
      "minimum": 0
    },
    "proposals_written": {
      "type": "integer",
      "minimum": 0
    },
    "needs_review": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    }
  }
}
