{
  "$schema": "../contracts/src/hasna.contract.schema.json",
  "schema": "hasna.service_contract.v1",
  "name": "context",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Self-hosted documentation context server for AI coding agents — refresh, index, and query source docs via CLI, MCP, HTTP API, and the package SDK. The local store is SQLite at ~/.hasna/context/context.db; the storage-sync layer reads PostgreSQL selected by HASNA_CONTEXT_DATABASE_URL. The data backend is the only runtime switch.",
  "bins": [
    "context",
    "context-mcp",
    "context-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "context-serve",
      "authMode": "custom",
      "openApiPath": "/openapi.json",
      "health": { "method": "GET", "path": "/health", "public": true },
      "readiness": { "method": "GET", "path": "/ready", "public": true },
      "version": { "method": "GET", "path": "/version", "public": true }
    },
    {
      "name": "package-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "context-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "context",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CONTEXT_",
    "aliasEnvPrefix": "CONTEXT_",
    "sqlitePath": "~/.hasna/context/context.db",
    "pgTestGate": {
      "envVar": "HASNA_CONTEXT_TEST_DATABASE_URL",
      "command": "bun test src/db/remote-fts.pg.test.ts"
    }
  },
  "metadata": {
    "conformance": {
      "waivedAssetInventories": [
        {
          "kind": "domain",
          "reason": "The package deliberately ships its public documentation-source seed catalog; these are third-party public reference locations, not Hasna-owned assets.",
          "reviewedBy": "fleet_register_operation_reviewer",
          "expiresAt": "2026-11-19T00:00:00Z"
        },
        {
          "kind": "host",
          "reason": "The package deliberately ships its public documentation-source seed catalog; these are third-party public reference locations, not Hasna-owned assets.",
          "reviewedBy": "fleet_register_operation_reviewer",
          "expiresAt": "2026-11-19T00:00:00Z"
        }
      ]
    },
    "release": {
      "artifactScan": {
        "script": "scan-artifact"
      }
    }
  }
}
