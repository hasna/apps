{
  "name": "@hasna/capacity",
  "version": "0.1.1",
  "description": "Fail-closed provider account capacity metadata for local and self-hosted Hasna deployments",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/capacity.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capacity": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "capacity": "scripts/capacity-launcher.mjs"
  },
  "files": [
    "dist",
    "scripts/capacity-launcher.mjs",
    "scripts/harden-cli-permissions.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target bun --format esm && bun build src/cli.ts --outfile dist/cli.js --target bun --format esm",
    "build:types": "tsc -p tsconfig.build.json",
    "postinstall": "bun scripts/harden-cli-permissions.mjs",
    "prepack": "bun run build",
    "test": "bun test",
    "test:package": "bun test test/package/artifact.test.ts",
    "test:unit": "bun test test/unit",
    "test:storage": "bun test test/storage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
