{
  "schema": "hasna.service_contract.v1",
  "name": "router",
  "class": "library",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Deterministic smart model router companion for gateway.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "router"
  ],
  "serviceSurfaces": [
    {
      "name": "router-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "router",
      "authMode": "local-only"
    },
    {
      "name": "router-lib",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": "."
    }
  ],
  "metadata": {
    "conformance": {
      "waivedSurfaces": [
        {
          "kind": "api",
          "reason": "No HTTP API product surface: src/server.ts is an optional in-process gateway-options server for the CLI smoke flow, not a shipped service API with /ready//version or OpenAPI."
        },
        {
          "kind": "mcp",
          "reason": "No MCP server surface is shipped by @hasna/router."
        }
      ]
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
