{
  "policy": {
    "allowTraining": false,
    "allowLogging": false,
    "allowChineseProviders": false,
    "byokOnly": true,
    "blockedRegions": ["cn"]
  },
  "providers": [
    {
      "id": "openai",
      "displayName": "OpenAI",
      "kind": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "enabled": true,
      "regions": ["us"],
      "jurisdiction": "us",
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": false,
        "zeroDataRetentionAvailable": false,
        "byokOnly": true
      },
      "gateway": {
        "kind": "direct",
        "openAiCompatible": true,
        "requestOptionsShape": "openai-compatible"
      }
    },
    {
      "id": "openrouter",
      "displayName": "OpenRouter",
      "kind": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "enabled": true,
      "regions": ["global"],
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": true,
        "zeroDataRetentionAvailable": false,
        "byokOnly": true
      },
      "gateway": {
        "kind": "openrouter",
        "openAiCompatible": true,
        "requestOptionsShape": "openrouter-provider",
        "docsUrl": "https://openrouter.ai/docs/guides/routing/provider-selection"
      }
    },
    {
      "id": "vercel-ai-gateway",
      "displayName": "Vercel AI Gateway",
      "kind": "openai-compatible",
      "baseUrl": "https://ai-gateway.vercel.sh/v1",
      "apiKeyEnv": "AI_GATEWAY_API_KEY",
      "enabled": true,
      "regions": ["global"],
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": true,
        "zeroDataRetentionAvailable": false,
        "byokOnly": true
      },
      "gateway": {
        "kind": "vercel-ai-gateway",
        "openAiCompatible": true,
        "requestOptionsShape": "vercel-provider-options",
        "docsUrl": "https://vercel.com/docs/ai-gateway/models-and-providers/provider-options"
      }
    },
    {
      "id": "litellm-proxy",
      "displayName": "LiteLLM Proxy",
      "kind": "openai-compatible",
      "baseUrlEnv": "LITELLM_PROXY_BASE_URL",
      "apiKeyEnv": "LITELLM_API_KEY",
      "enabled": true,
      "regions": ["private"],
      "jurisdiction": "self-hosted",
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": false,
        "zeroDataRetentionAvailable": true,
        "byokOnly": true
      },
      "gateway": {
        "kind": "litellm-proxy",
        "openAiCompatible": true,
        "requestOptionsShape": "headers-and-config",
        "docsUrl": "https://docs.litellm.ai/docs/proxy/load_balancing"
      }
    },
    {
      "id": "portkey",
      "displayName": "Portkey AI Gateway",
      "kind": "openai-compatible",
      "baseUrl": "https://api.portkey.ai/v1",
      "auth": {
        "type": "header",
        "apiKeyEnv": "PORTKEY_API_KEY",
        "headerName": "x-portkey-api-key",
        "prefix": ""
      },
      "headers": {
        "x-portkey-config": { "env": "PORTKEY_CONFIG_ID" }
      },
      "enabled": true,
      "regions": ["global"],
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": true,
        "zeroDataRetentionAvailable": false,
        "byokOnly": true
      },
      "gateway": {
        "kind": "portkey",
        "openAiCompatible": true,
        "requestOptionsShape": "headers-and-config",
        "docsUrl": "https://portkey.ai/docs/product/ai-gateway/load-balancing"
      }
    },
    {
      "id": "cloudflare-ai-gateway",
      "displayName": "Cloudflare AI Gateway",
      "kind": "openai-compatible",
      "baseUrlEnv": "CLOUDFLARE_AI_GATEWAY_BASE_URL",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "enabled": true,
      "regions": ["global"],
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": true,
        "zeroDataRetentionAvailable": false,
        "byokOnly": true
      },
      "gateway": {
        "kind": "cloudflare-ai-gateway",
        "openAiCompatible": true,
        "requestOptionsShape": "headers-and-config",
        "docsUrl": "https://developers.cloudflare.com/ai-gateway/usage/rest-api/"
      }
    },
    {
      "id": "kong-ai-gateway",
      "displayName": "Kong AI Gateway",
      "kind": "openai-compatible",
      "baseUrlEnv": "KONG_AI_GATEWAY_BASE_URL",
      "apiKeyEnv": "KONG_AI_GATEWAY_API_KEY",
      "enabled": true,
      "regions": ["private"],
      "jurisdiction": "self-hosted",
      "dataPolicy": {
        "allowTraining": false,
        "allowLogging": false,
        "zeroDataRetentionAvailable": true,
        "byokOnly": true
      },
      "gateway": {
        "kind": "kong-ai-gateway",
        "openAiCompatible": true,
        "requestOptionsShape": "headers-and-config",
        "docsUrl": "https://developer.konghq.com/ai-gateway/load-balancing/"
      }
    }
