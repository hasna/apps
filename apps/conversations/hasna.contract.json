{
  "schema": "hasna.service_contract.v1",
  "name": "conversations",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Real-time messaging + coordination for AI agents: channels, messages, projects, presence, tasks. CLI + MCP + HTTP API (conversations-serve) + generated SDK. Clients use local SQLite or the HTTP API selected by HASNA_CONVERSATIONS_API_URL; conversations-serve reads PostgreSQL selected by HASNA_CONVERSATIONS_DATABASE_URL. The data backend is the only runtime switch.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "conversations",
    "conversations-inbox",
    "conversations-mcp",
    "conversations-serve",
    "conversations-hook"
  ],
  "serviceSurfaces": [
    {
      "name": "conversations-api",
      "kind": "api",
      "status": "supported",
      "bin": "conversations-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/v1/openapi.json"
    },
    {
      "name": "conversations-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/v1/openapi.json"
    },
    {
      "name": "conversations-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "conversations",
      "authMode": "local-only"
    },
    {
      "name": "conversations-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "conversations-mcp",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CONVERSATIONS_",
    "aliasEnvPrefix": "CONVERSATIONS_",
    "sqlitePath": "~/.hasna/conversations/conversations.db",
    "pgTestGate": {
      "envVar": "CONVERSATIONS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "metadata": {
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/v1/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretEnvVar": "HASNA_CONVERSATIONS_API_SIGNING_KEY",
      "databaseUrlEnvVar": "HASNA_CONVERSATIONS_DATABASE_URL",
      "databaseUrlOwnerEnvVar": "HASNA_CONVERSATIONS_DATABASE_URL_OWNER"
    },
    "client": {
      "apiUrlEnv": "HASNA_CONVERSATIONS_API_URL",
      "apiKeyEnv": "HASNA_CONVERSATIONS_API_KEY"
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
