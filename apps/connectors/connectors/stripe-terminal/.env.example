# Stripe Terminal API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys

STRIPE_TERMINAL_API_KEY=your_stripe_secret_key_here

# Optional: Account ID (required for organization API keys sk_org_*)
# STRIPE_TERMINAL_ACCOUNT_ID=acct_your_account_id_here

# Optional: Stripe API version (defaults to 2025-01-27.acacia)
# STRIPE_TERMINAL_API_VERSION=2025-01-27.acacia

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_TERMINAL_BASE_URL=https://api.stripe.com/v1
