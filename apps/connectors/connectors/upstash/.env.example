# Upstash account email (from https://console.upstash.com/account/api)
UPSTASH_EMAIL=your-email@example.com

# Upstash API key (from https://console.upstash.com/account/api)
UPSTASH_API_KEY=your-api-key-here

# Optional: override control-plane API base URL
# UPSTASH_BASE_URL=https://api.upstash.com/v2
