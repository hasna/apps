# Tableau REST API credentials
# All values below are placeholders — replace with your own.

# Tableau Server / Tableau Cloud base URL (no trailing slash)
TABLEAU_SERVER_URL=https://your-server.example.com

# Site content URL. Leave empty ("") for the Default site on Tableau Server.
# On Tableau Cloud this is the site name from your pod URL.
TABLEAU_SITE_NAME=your-site-content-url

# Optional: REST API version to target (defaults to a current version if unset)
# TABLEAU_API_VERSION=3.21

# --- Authentication (choose ONE of the two methods below) ---

# Option A: Personal Access Token (recommended)
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_SECRET=your-pat-secret

# Option B: Username and password
# TABLEAU_USERNAME=your-username
# TABLEAU_PASSWORD=your-password
