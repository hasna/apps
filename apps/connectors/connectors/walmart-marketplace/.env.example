# Walmart Marketplace API credentials (OAuth access token)
WALMART_ACCESS_TOKEN=your-access-token-here

# Walmart service name header (WM_SVC.NAME) — set per your Walmart developer app
WALMART_SERVICE_NAME=your-service-name-here

# Optional: override API base URL (default: https://marketplace.walmartapis.com/v3)
# WALMART_BASE_URL=https://marketplace.walmartapis.com/v3
