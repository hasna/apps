# Wufoo API credentials
# Find your API key and subdomain at: Form Manager → More → API Information

WUFOO_API_KEY=your-api-key-here
WUFOO_SUBDOMAIN=your-subdomain

# Optional: override base URL (defaults to https://{subdomain}.wufoo.com/api/v3)
# WUFOO_BASE_URL=https://your-subdomain.wufoo.com/api/v3
