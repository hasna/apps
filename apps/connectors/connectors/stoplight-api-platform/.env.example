# Stoplight API credentials
#
# Create a Workspace Token (read-only) or a Personal Access Token from your
# Stoplight workspace settings, then place it below. Tokens are sent verbatim
# in the Authorization header (no "Bearer" prefix).
STOPLIGHT_API_TOKEN=[REDACTED]

# Optional: override the API base URL (defaults to https://stoplight.io/api)
# STOPLIGHT_BASE_URL=https://stoplight.io/api
