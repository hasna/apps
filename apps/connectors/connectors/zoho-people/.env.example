# Zoho People OAuth access token (Zoho-oauthtoken)
ZOHOPEOPLE_TOKEN=your-oauth-access-token-here

# Data center: com | eu | in | com.au | jp | ca | sa (default: com)
ZOHOPEOPLE_DATA_CENTER=com

# Optional: override API base URL (defaults to people.zoho.{dc})
# ZOHOPEOPLE_BASE_URL=https://people.zoho.com
