# Zatanna API credentials (placeholders only)
ZATANNA_API_KEY=your-api-key-here

# Optional: override API base URL (default https://api.zatanna.ai/v1)
# ZATANNA_BASE_URL=https://api.zatanna.ai/v1

# Optional: custom auth header name (default Authorization Bearer)
# ZATANNA_AUTH_HEADER=Authorization

# Optional: default workspace for workflow queries
# ZATANNA_DEFAULT_WORKSPACE_ID=your-workspace-id
