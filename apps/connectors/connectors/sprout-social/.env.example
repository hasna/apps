# Sprout Social API Credentials
# Generate an API access token from Settings > API in your Sprout Social account.
# See https://api.sproutsocial.com/docs/ for details.

# Bearer access token (required)
SPROUTSOCIAL_ACCESS_TOKEN=your-access-token-here

# Numeric customer id the token has access to (required for most endpoints).
# Retrieve it via: connect-sprout-social metadata client
SPROUTSOCIAL_CUSTOMER_ID=your-customer-id

# Optional: override the API base URL
# SPROUTSOCIAL_BASE_URL=https://api.sproutsocial.com/v1
