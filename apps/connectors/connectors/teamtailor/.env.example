# Teamtailor API Credentials
# Generate an API key in Teamtailor under Settings > Integrations > API keys.
# Authentication uses: Authorization: Token token=<TEAMTAILOR_API_KEY>

TEAMTAILOR_API_KEY=your-api-key-here

# Optional: API version date sent as the required X-Api-Version header.
# Defaults to a stable version if unset. Format: YYYYMMDD
# TEAMTAILOR_API_VERSION=20240904

# Optional: Custom base URL (defaults to https://api.teamtailor.com/v1)
# TEAMTAILOR_BASE_URL=https://api.teamtailor.com/v1
