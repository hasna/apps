# SmartRecruiters API Credentials
#
# Create a company API key (SmartToken) in SmartRecruiters under
# Settings > Apps & Integrations > Credentials. It is sent as the
# X-SmartToken request header and grants access to your company data.

SMARTRECRUITERS_API_KEY=your-api-key-here

# Optional: default company identifier for the public Posting API
# (the "companyIdentifier" segment of /v1/companies/{companyIdentifier}/postings)
# SMARTRECRUITERS_COMPANY_ID=your-company-identifier

# Optional: override the API base URL (defaults to https://api.smartrecruiters.com)
# SMARTRECRUITERS_BASE_URL=https://api.smartrecruiters.com
