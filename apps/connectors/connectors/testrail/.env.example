# TestRail API credentials (HTTP Basic: email + API key)
# Generate an API key in TestRail: My Settings → API Keys

TESTRAIL_EMAIL=your-email@example.com
TESTRAIL_API_KEY=your-api-key-here

# Instance base URL (cloud or self-hosted)
# Cloud example: https://yourcompany.testrail.io
TESTRAIL_BASE_URL=https://yourcompany.testrail.io
