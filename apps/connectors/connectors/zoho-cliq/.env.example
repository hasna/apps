# Zoho Cliq OAuth access token
# Generate via Zoho API Console: https://api-console.zoho.com/

ZOHO_CLIQ_TOKEN=

# Data center: com | eu | in | com.au | jp | ca | sa
ZOHO_CLIQ_DATA_CENTER=com

# Optional: override API base URL (defaults to https://cliq.zoho.{dc}/api/v2)
# ZOHO_CLIQ_BASE_URL=https://cliq.zoho.com/api/v2
