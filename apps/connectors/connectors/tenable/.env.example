# Tenable Vulnerability Management (Tenable.io) API credentials
# Generate API keys in the Tenable UI: Settings > My Account > API Keys
# See https://developer.tenable.com/docs/authorization

TENABLE_ACCESS_KEY=your-access-key-here
TENABLE_SECRET_KEY=your-secret-key-here

# Optional: Custom API base URL (defaults to https://cloud.tenable.com)
# TENABLE_BASE_URL=https://cloud.tenable.com
