# Windmill API credentials
WINDMILL_API_KEY=your-api-key-here

# Optional: override API base URL (default https://api.windmill.dev/v1)
# For self-hosted Windmill, use your instance base URL, e.g.:
# WINDMILL_BASE_URL=https://app.windmill.dev/api/w/your-workspace

# Optional: workspace ID or slug (sent as X-Workspace header when set)
# WINDMILL_WORKSPACE=your-workspace
