{
  "name": "@hasna/connect-wave-accounting",
  "version": "0.0.1",
  "description": "Wave Accounting connector - GraphQL API for businesses, invoices, customers, and accounts",
  "type": "module",
  "bin": {
    "connect-wave-accounting": "./bin/index.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf ./dist ./bin && tsc --emitDeclarationOnly && bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun",
    "dev": "bun run ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run"
  },
  "keywords": [
    "wave",
    "wave-accounting",
    "accounting",
    "invoicing",
    "graphql",
    "finance",
    "api",
    "connector",
    "cli",
    "typescript",
    "bun"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps.git"
  }
}
