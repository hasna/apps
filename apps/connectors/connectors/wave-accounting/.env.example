# Wave Accounting API credentials (placeholders only)
# Full-access token for development: https://developer.waveapps.com
WAVE_ACCESS_TOKEN=your-wave-access-token-here

# OAuth2 client credentials (for published apps)
WAVE_CLIENT_ID=your-oauth-client-id-here
WAVE_CLIENT_SECRET=your-oauth-client-secret-here

# Optional: default business ID for multi-business tokens
# WAVE_BUSINESS_ID=your-business-id-here
