# Stripe API Credentials
# Get your secret API key from https://dashboard.stripe.com/apikeys

STRIPE_API_KEY=your_stripe_api_key_here

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_BASE_URL=https://api.stripe.com/v1

# Optional: Pin a Stripe API version (defaults to the connector's built-in version)
# STRIPE_API_VERSION=2025-01-27.acacia
