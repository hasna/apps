{
  "name": "@hasna/connect-turbot-pipes",
  "version": "0.0.1",
  "description": "Turbot Pipes connector - Cloud intelligence workspaces, queries, and snapshots",
  "type": "module",
  "bin": {
    "connect-turbot-pipes": "./bin/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir ./dist && bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun",
    "dev": "bun run ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "turbot-pipes",
    "turbot",
    "steampipe",
    "cloud",
    "intelligence",
    "sql",
    "connector",
    "cli",
    "typescript",
    "bun"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps.git"
  }
}
