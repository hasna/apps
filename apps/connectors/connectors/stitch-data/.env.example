# Stitch (Stitch Connect) Credentials
# Create a non-expiring API access token from the Stitch dashboard:
# https://www.stitchdata.com/docs/developers/stitch-connect/guide#authentication
STITCH_ACCESS_TOKEN=your_access_token_here

# Optional: Stitch client (account) ID. Required for the extractions and loads
# reporting endpoints. Find it in the dashboard URL or the source report card.
STITCH_CLIENT_ID=your_client_id_here

# Optional: Override the API base URL (defaults to https://api.stitchdata.com)
STITCH_BASE_URL=https://api.stitchdata.com
