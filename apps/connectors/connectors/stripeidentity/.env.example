# Stripe Identity API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys

STRIPE_IDENTITY_API_KEY=your_stripe_secret_key_here

# Optional: Account ID for organization API keys (Stripe-Context header)
# STRIPE_IDENTITY_ACCOUNT_ID=acct_your-account-id-here

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_IDENTITY_BASE_URL=https://api.stripe.com/v1
