# Tave API Credentials
#
# Create an API key from your Tave account settings and paste it below.
# Tave uses Bearer token authentication:
#   Authorization: Bearer <TAVE_API_KEY>

TAVE_API_KEY=your-api-key-here

# Optional: override the API base URL (defaults to https://tave.io/v2)
# TAVE_BASE_URL=https://tave.io/v2
