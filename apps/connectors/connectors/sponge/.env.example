# Sponge (PaySponge Agent Wallet) API Credentials
# Create an agent and issue an API key from your PaySponge dashboard.

# Required: agent API key, sent as `Authorization: Bearer <key>`
SPONGE_API_KEY=[REDACTED]

# Optional: override the API base URL (defaults to https://api.wallet.paysponge.com)
# SPONGE_BASE_URL=https://api.wallet.paysponge.com

# Optional: pin a specific API revision via the `Sponge-Version` header
# SPONGE_VERSION=0.2.2
