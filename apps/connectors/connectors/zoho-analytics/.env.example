# Zoho Analytics OAuth credentials (from Zoho API console)
ZOHO_ANALYTICS_TOKEN=your-oauth-access-token
ZOHO_ANALYTICS_ORG_ID=your-organization-id

# Optional: data center region (com, eu, in, com.au, jp, ca, sa)
# ZOHO_ANALYTICS_DATA_CENTER=com

# Optional: override API base URL
# ZOHO_ANALYTICS_BASE_URL=https://analyticsapi.zoho.com
