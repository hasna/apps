{
  "name": "@hasna/connect-solcast",
  "version": "0.1.0",
  "description": "Solcast API connector CLI - Solar PV power forecasts, live data, and historic estimates",
  "type": "module",
  "bin": {
    "connect-solcast": "./bin/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf ./dist ./bin && bun build ./src/index.ts --outdir ./dist --target bun && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir ./dist && bun build ./src/cli/index.ts --outdir ./bin --target bun",
    "dev": "bun run ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "keywords": [
    "solcast",
    "solar",
    "pv",
    "forecast",
    "weather",
    "api",
    "connector",
    "cli",
    "typescript",
    "bun",
    "hasna"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/connectors.git"
  }
}
