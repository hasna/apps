# Talkdesk API credentials (OAuth 2.0 client credentials grant)
# Create an OAuth client in Talkdesk Admin > Integrations > OAuth Clients
# with the "Client Credentials" grant type, then copy the values below.
# See: https://docs.talkdesk.com/docs/client-credentials

# OAuth client ID (placeholder - replace with your own)
TALKDESK_CLIENT_ID=your-client-id-here

# OAuth client secret (placeholder - replace with your own)
TALKDESK_CLIENT_SECRET=your-client-secret-here

# Optional: pre-obtained bearer access token (skips the token exchange)
# TALKDESK_ACCESS_TOKEN=your-access-token-here

# Optional: API base URL (defaults to https://api.talkdeskapp.com)
# Use the base URL matching the region where your Talkdesk account is hosted.
# TALKDESK_BASE_URL=https://api.talkdeskapp.com

# Required for client-credentials auth: OAuth token endpoint for your Talkdesk account.
# US/default: https://<talkdesk-account-name>.talkdeskid.com/oauth/token
# EU: https://<talkdesk-account-name>.talkdeskid.eu/oauth/token
# CA: https://<talkdesk-account-name>.talkdeskidca.com/oauth/token
# AU: https://<talkdesk-account-name>.talkdeskid.au/oauth/token
TALKDESK_AUTH_URL=https://your-account.talkdeskid.com/oauth/token
