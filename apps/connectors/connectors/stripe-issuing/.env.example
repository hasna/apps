# Stripe Issuing API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys

STRIPE_ISSUING_API_KEY=your_stripe_secret_key_here

# Optional: Stripe account ID (required for organization API keys)
# STRIPE_ISSUING_ACCOUNT_ID=acct_your_account_id

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_ISSUING_BASE_URL=https://api.stripe.com/v1

# Optional: Pin Stripe API version
# STRIPE_ISSUING_API_VERSION=2025-01-27.acacia
