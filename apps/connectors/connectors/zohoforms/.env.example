# Zoho Forms OAuth access token (from Zoho OAuth flow)
# See: https://www.zoho.com/forms/help/api/
ZOHOFORMS_TOKEN=your-oauth-access-token-here

# Zoho data center: com | eu | in | com.au | jp | ca | sa (default: com)
ZOHOFORMS_DATA_CENTER=com

# Optional: override API base URL (normally derived from data center)
# ZOHOFORMS_BASE_URL=https://forms.zoho.com/api/v2
