# Trigger.dev secret key (Bearer token)
# Create at https://cloud.trigger.dev → Project → API Keys
TRIGGER_SECRET_KEY=your-secret-key-here

# Optional: legacy env name, still supported
# TRIGGER_DEV_API_KEY=your-secret-key-here

# Optional: override API base URL (default https://api.trigger.dev/api/v1)
# TRIGGER_DEV_BASE_URL=https://api.trigger.dev/api/v1
