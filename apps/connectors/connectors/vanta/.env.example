# Vanta Manage API OAuth credentials (from Vanta Developer Console)
VANTA_CLIENT_ID=your-client-id-here
VANTA_CLIENT_SECRET=your-client-secret-here

# OAuth scope (space-separated). Read-only: vanta-api.all:read
VANTA_SCOPE=vanta-api.all:read

# API base URL for resource endpoints (default: commercial)
VANTA_BASE_URL=https://api.vanta.com/v1

# Vanta Gov (FedRAMP) customers use:
# VANTA_BASE_URL=https://api.vanta-gov.com/v1
