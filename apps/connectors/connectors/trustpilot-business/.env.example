# Trustpilot Business API credentials
# Get keys from Trustpilot Business > Integrations > Developers

TRUSTPILOT_BUSINESS_API_KEY=your-api-key-here

# Optional: required for private Business API routes (/private/*)
TRUSTPILOT_BUSINESS_API_SECRET=your-api-secret-here

# Optional: override API base URL (default https://api.trustpilot.com/v1)
# TRUSTPILOT_BUSINESS_BASE_URL=https://api.trustpilot.com/v1

# Optional: invitations API base URL (default https://invitations-api.trustpilot.com/v1)
# TRUSTPILOT_BUSINESS_INVITATIONS_BASE_URL=https://invitations-api.trustpilot.com/v1
