# Teamwork API credentials
#
# Generate an API token from your Teamwork account:
#   Profile menu -> Edit My Details -> API & Mobile -> "Show your token"
# The connector authenticates with HTTP Basic auth using this token.

# Your Teamwork API token
TEAMWORK_API_KEY=your-api-token-here

# Your Teamwork site name (the subdomain of {installation}.teamwork.com)
TEAMWORK_INSTALLATION=your-site-name

# Optional: full base URL override (defaults to https://{installation}.teamwork.com)
# TEAMWORK_BASE_URL=https://your-site-name.teamwork.com
