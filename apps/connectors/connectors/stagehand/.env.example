# Stagehand Browserbase session API
# Set these environment variables or use profile configuration.

BROWSERBASE_API_KEY=your_browserbase_api_key_here
MODEL_API_KEY=your_model_provider_api_key_here

# Optional: Browserbase project ID for accounts that still require x-bb-project-id.
# Browserbase API keys are project-scoped in current docs, so this is usually not needed.
# BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# Optional: Base URL (defaults to https://api.stagehand.browserbase.com)
# STAGEHAND_BASE_URL=https://api.stagehand.browserbase.com
