# Stamped.io API credentials
# Create these under Settings -> API Keys in your Stamped.io dashboard.
# Private API requests put the ShopId/storeHash in the path and send the private
# API key in the stamped-api-key header.

# Public API key used for public widget endpoints
STAMPEDIO_PUBLIC_KEY=your-public-key-here

# Private API key - keep this secret
STAMPEDIO_PRIVATE_KEY=your-private-key-here

# ShopId/storeHash - found in Settings -> API Keys
STAMPEDIO_STORE_HASH=your-store-hash-here

# Storefront domain used by public widget endpoints (e.g. your-shop.myshopify.com)
# STAMPEDIO_STORE_URL=your-store-domain-here
