{
  "name": "@hasna/connect-cloudflare-workers",
  "version": "0.0.1",
  "description": "Cloudflare Workers REST API connector for scripts, uploads, routes, deployments, versions, secrets, tails, subdomains, beta workers, and scoped raw requests",
  "type": "module",
  "bin": {
    "connect-cloudflare-workers": "./bin/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "bun run ./src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": ["cloudflare", "workers", "serverless", "edge", "scripts", "deployments", "routes", "connector", "cli", "typescript", "bun"],
  "author": "Hasna",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps.git"
  }
}
