# Sumo Logic API Credentials
# Create an access key at: Administration > Security > Access Keys
# Docs: https://help.sumologic.com/docs/manage/security/access-keys/

SUMOLOGIC_ACCESS_ID=your-access-id-here
SUMOLOGIC_ACCESS_KEY=your-access-key-here

# Optional: deployment/region used to select the API endpoint.
# One of: us1, us2, eu, au, ca, de, jp, in, fed  (default: us1)
# SUMOLOGIC_DEPLOYMENT=us1

# Optional: fully-qualified API endpoint override (takes precedence over deployment)
# Example: https://api.eu.sumologic.com
# SUMOLOGIC_ENDPOINT=https://api.sumologic.com
