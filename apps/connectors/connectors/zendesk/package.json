{
  "name": "@hasna/connect-zendesk",
  "version": "0.2.0",
  "description": "Zendesk API connector CLI - A TypeScript wrapper for the Zendesk API",
  "type": "module",
  "bin": {
    "connect-zendesk": "bin/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun && bun build ./src/server/index.ts --outdir ./server --target bun",
    "dev": "bun run ./src/cli/index.ts",
    "server": "bun run ./src/server/index.ts",
    "server:prod": "NODE_ENV=production bun run ./src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "release": "bun run ./scripts/publish.ts",
    "release:patch": "bun run ./scripts/publish.ts patch",
    "release:minor": "bun run ./scripts/publish.ts minor",
    "release:major": "bun run ./scripts/publish.ts major",
    "release:dry": "bun run ./scripts/publish.ts --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/connect-zendesk.git"
  },
  "homepage": "https://github.com/hasna/connect-zendesk#readme",
  "bugs": {
    "url": "https://github.com/hasna/connect-zendesk/issues"
  },
  "keywords": [
    "zendesk",
    "api",
    "connector",
    "cli",
    "typescript",
    "bun",
    "support",
    "helpdesk",
    "tickets"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
