# Tenor API credentials
# Get a key from Google Cloud (Tenor API): https://developers.google.com/tenor/guides/quickstart

# Required: your Tenor API key (sent as the `key` query parameter)
TENOR_API_KEY=your-tenor-api-key

# Optional: client key that identifies your integration to Tenor
# TENOR_CLIENT_KEY=your-client-key

# Optional: override the default API base URL
# TENOR_BASE_URL=https://tenor.googleapis.com/v2
