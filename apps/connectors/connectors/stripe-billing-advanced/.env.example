# Stripe secret key
STRIPE_BILLING_ADVANCED_API_KEY=your_stripe_secret_key

# Stripe API version for v2 billing endpoints (preview required)
# STRIPE_BILLING_ADVANCED_API_VERSION=2026-05-27.preview

# Optional: override API base URL (default https://api.stripe.com)
# STRIPE_BILLING_ADVANCED_BASE_URL=https://api.stripe.com
