# Zoho Projects OAuth access token (from Zoho API Console)
ZOHOPROJECTS_TOKEN=your-oauth-access-token

# Default portal ID for portal-scoped API calls
ZOHOPROJECTS_PORTAL_ID=your-portal-id

# Zoho data center: com | eu | in | com.au | jp | ca | sa
ZOHOPROJECTS_DATA_CENTER=com

# Optional: override API base URL (defaults from data center)
# ZOHOPROJECTS_BASE_URL=https://projectsapi.zoho.com
