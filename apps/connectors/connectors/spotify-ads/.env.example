# Spotify Ads API OAuth credentials (from developer.spotify.com dashboard)
SPOTIFY_ADS_CLIENT_ID=your-client-id
SPOTIFY_ADS_CLIENT_SECRET=your-client-secret

# Optional: pre-issued tokens (skip OAuth login when set)
SPOTIFY_ADS_ACCESS_TOKEN=your-access-token
SPOTIFY_ADS_REFRESH_TOKEN=your-refresh-token

# Optional: override API base URL (defaults to v3 partner endpoint)
# SPOTIFY_ADS_BASE_URL=https://api-partner.spotify.com/ads/v3
