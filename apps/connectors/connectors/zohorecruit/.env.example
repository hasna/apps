# Zoho Recruit OAuth access token (Zoho-oauthtoken)
ZOHORECRUIT_TOKEN=your-oauth-access-token

# Data center: com | eu | in | com.au | jp | ca | sa (default: com)
ZOHORECRUIT_DATA_CENTER=com

# Optional: override API base URL (defaults to https://recruit.zoho.{dc}/recruit/v2)
# ZOHORECRUIT_BASE_URL=https://recruit.zoho.com/recruit/v2
