# Synphony API credentials
# Get your API key from your Synphony account dashboard.

# Required: API key used as a Bearer token (Authorization: Bearer <key>)
SYNPHONY_API_KEY=your-api-key-here

# Optional: Override the API base URL (defaults to https://api.synphony.ai/v1)
# SYNPHONY_BASE_URL=https://api.synphony.ai/v1
