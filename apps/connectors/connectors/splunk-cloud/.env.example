# Splunk Cloud Platform credentials
#
# Base URL of your Splunk Cloud stack's REST management endpoint (port 8089).
# Replace <stack> with your Splunk Cloud stack name.
SPLUNK_CLOUD_BASE_URL=https://<stack>.splunkcloud.com:8089

# Authentication token (recommended). Create one under
# Settings > Tokens in Splunk Web, or via the authorization/tokens endpoint.
SPLUNK_CLOUD_TOKEN=your-splunk-cloud-token-here

# Optional: username/password (Basic auth) instead of a token.
# SPLUNK_CLOUD_USERNAME=your-username-here
# SPLUNK_CLOUD_PASSWORD=your-password-here
