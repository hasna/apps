# Taboola Backstage API credentials
# Obtain client_id and client_secret from your Taboola account manager.
# Docs: https://developers.taboola.com/backstage-api/reference

# OAuth2 client credentials (client_credentials grant)
TABOOLA_CLIENT_ID=your-client-id-here
TABOOLA_CLIENT_SECRET=your-client-secret-here

# Default account (network) id to operate on, e.g. the account_id
# returned by /users/current/allowed-accounts
TABOOLA_ACCOUNT_ID=your-account-id-here

# Optional: use a pre-issued Bearer access token instead of client credentials
# TABOOLA_ACCESS_TOKEN=your-access-token-here

# Optional: override the API base URL
# TABOOLA_BASE_URL=https://backstage.taboola.com/backstage
