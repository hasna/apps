# TrueLayer API access token (Bearer token)
TRUELAYER_ACCESS_TOKEN=your-access-token-here

# Optional: OAuth client credentials (for token exchange flows)
# TRUELAYER_CLIENT_ID=your-client-id
# TRUELAYER_CLIENT_SECRET=your-client-secret

# Optional: Override API base URL (defaults to production or sandbox)
# TRUELAYER_BASE_URL=https://api.truelayer.com/v1

# Optional: Use sandbox environment (true/false)
# TRUELAYER_SANDBOX=false
