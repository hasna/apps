# Apache Superset connector configuration
# Copy to .env and replace the placeholder values with your own.
# All values below are placeholders — do NOT commit real credentials.

# Base URL of your self-hosted Superset instance (required, no trailing path)
SUPERSET_BASE_URL=https://superset.example.com

# Database (username/password) login credentials
SUPERSET_USERNAME=your-username
SUPERSET_PASSWORD=your-password

# Auth provider used by the Superset login endpoint (default: db)
SUPERSET_PROVIDER=db

# Optional: supply a pre-issued JWT access token instead of username/password
SUPERSET_ACCESS_TOKEN=your-access-token

# Optional: refresh token used to mint new access tokens
SUPERSET_REFRESH_TOKEN=your-refresh-token
