# Zoho Inventory OAuth access token
ZOHOINVENTORY_TOKEN=your-oauth-access-token-here

# Zoho Inventory organization ID
ZOHOINVENTORY_ORG_ID=your-organization-id-here

# Optional: regional API base URL (default: https://www.zohoapis.com/inventory/v1)
# ZOHOINVENTORY_BASE_URL=https://www.zohoapis.eu/inventory/v1
