# Smile.io API Credentials
# Create a private API key in your Smile.io admin under Settings > API keys.
# Requests authenticate with: Authorization: Bearer <SMILEIO_API_KEY>
# Keep this secret out of client-side code and public repositories.

SMILEIO_API_KEY=your-smile-api-key-here

# Optional: override the API base URL (defaults to https://api.smile.io/v1)
# SMILEIO_BASE_URL=https://api.smile.io/v1
