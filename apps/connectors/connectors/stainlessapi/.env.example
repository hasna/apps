# Stainless API Key
# Get your API key from: https://app.stainless.com/ (Settings > API keys)
STAINLESS_API_KEY=your_stainless_api_key_here

# Optional: default project applied to project-scoped commands
# STAINLESS_PROJECT=your_project_slug

# Optional: override the API base URL (defaults to https://api.stainless.com)
# STAINLESS_BASE_URL=https://api.stainless.com
