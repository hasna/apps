# WebEngage REST API credentials
# Find these in WebEngage dashboard: Data Platform > Integrations > REST API

WEBENGAGE_API_KEY=your-api-key-here
WEBENGAGE_LICENSE_CODE=your-license-code-here

# Data center: global (default), in, sa, eug
# WEBENGAGE_DC=global

# Optional: override API host (otherwise derived from WEBENGAGE_DC)
# WEBENGAGE_BASE_URL=https://api.webengage.com
