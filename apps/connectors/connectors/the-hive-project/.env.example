# TheHiveProject API credentials (placeholders only)
THE_HIVE_PROJECT_API_KEY=your-api-key-here

# Required: your TheHive instance root URL. The connector appends /api/v1.
THE_HIVE_PROJECT_BASE_URL=https://thehive.example

# Optional: target a non-default TheHive organisation.
# THE_HIVE_PROJECT_ORGANISATION=example-org
