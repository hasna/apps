# Sysdig API Credentials
# Find your API token in the Sysdig UI under Settings > User Profile.

SYSDIG_API_TOKEN=your-sysdig-api-token-here

# Optional: SaaS region identifier (default: us1)
# Supported: us1, us2, us4, eu1, eu2, au1, me2, in1, jp1
# SYSDIG_REGION=us1

# Optional: Custom base URL (for on-prem installs; overrides SYSDIG_REGION)
# SYSDIG_BASE_URL=https://api.sysdig.example.com
