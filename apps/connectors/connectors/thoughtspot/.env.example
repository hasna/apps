# ThoughtSpot REST API v2 credentials (placeholders only)
# Obtain a bearer token via POST /api/rest/2.0/auth/token/full on your instance.
# Docs: https://developers.thoughtspot.com/docs/api-authv2

THOUGHTSPOT_API_KEY=your-bearer-token-here

# Instance base URL including /api/rest/2.0 path, e.g.:
# THOUGHTSPOT_BASE_URL=https://your-instance.thoughtspot.cloud/api/rest/2.0
THOUGHTSPOT_BASE_URL=https://your-instance.thoughtspot.cloud/api/rest/2.0
