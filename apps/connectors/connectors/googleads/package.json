{
  "name": "@hasna/connect-googleads",
  "version": "0.1.0",
  "description": "Google Ads API connector CLI - Campaigns, ad groups, ads, keywords, and reporting",
  "type": "module",
  "bin": {
    "connect-googleads": "bin/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun",
    "dev": "bun run ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "keywords": [
    "google-ads",
    "adwords",
    "advertising",
    "ppc",
    "cli",
    "api",
    "hasna"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/connectors.git"
  }
}
