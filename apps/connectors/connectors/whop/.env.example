# Whop API credentials (https://docs.whop.com/developer/api/getting-started)
WHOP_API_KEY=your-api-key-here

# Company / account identifier (biz_xxx) — required for many list endpoints with API keys
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx

# Optional overrides
# WHOP_BASE_URL=https://api.whop.com/api/v1
# WHOP_API_VERSION_DATE=2026-06-20
