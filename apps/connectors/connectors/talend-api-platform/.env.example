# Talend API Platform connector configuration
# Copy to .env and fill in real values. Do NOT commit real tokens.

# Personal access token generated in Talend Cloud
# (Profile preferences > Personal access tokens > Add token)
TALEND_API_TOKEN=[REDACTED]

# Talend Cloud data-center region: us | eu | ap (default: us)
TALEND_REGION=us

# Optional: full API base URL override (private/dedicated deployments)
# TALEND_BASE_URL=https://api.us.cloud.talend.com/tmc/v1.2
