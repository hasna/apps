# Vercel API token (Bearer auth)
# Create at https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-api-token-here

# Optional: team scope for team-owned Edge Configs
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxx

# Optional: override management API base URL (default https://api.vercel.com)
# VERCEL_EDGE_CONFIG_BASE_URL=https://api.vercel.com
