# TikTok Ads Marketing API credentials
# Register an app at https://business-api.tiktok.com/portal/app

# OAuth app credentials (for auth login flow)
TIKTOK_ADS_CLIENT_ID=your_app_id
TIKTOK_ADS_CLIENT_SECRET=your_app_secret

# Long-lived access token (from OAuth or TikTok Ads Manager)
TIKTOK_ADS_ACCESS_TOKEN=your_access_token

# Default advertiser account ID
TIKTOK_ADS_ADVERTISER_ID=your_advertiser_id
