# WIPO API Key (optional - many APIs are open)
# Get your API key from: https://www.wipo.int/web-services/
WIPO_API_KEY=your_api_key_here

# Alternative env var name
# WIPO_TOKEN=your_api_key_here

# Optional: Browser automation settings
# WIPO_HEADLESS=true
# WIPO_BROWSER=chromium

# Optional: Default output directory
# WIPO_OUTPUT_DIR=./output
