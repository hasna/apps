# WebPageTest API key from https://www.webpagetest.org/account#api-consumers
WEBPAGETEST_API_KEY=your-api-key-here

# Optional: REST API base URL (default https://api.webpagetest.org/v1)
# WEBPAGETEST_BASE_URL=https://api.webpagetest.org/v1

# Optional: Classic API host for runtest.php / jsonResult.php (default https://www.webpagetest.org)
# WEBPAGETEST_CLASSIC_BASE_URL=https://www.webpagetest.org
