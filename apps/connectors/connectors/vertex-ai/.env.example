# Google Cloud OAuth2 credentials (Google Cloud Console → APIs & Services → Credentials)
VERTEX_AI_CLIENT_ID=your-client-id.apps.googleusercontent.com
VERTEX_AI_CLIENT_SECRET=your-client-secret

# Default GCP project and region for Vertex AI requests
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# Optional: override tokens (prefer `connect-vertex-ai auth login`)
# VERTEX_AI_ACCESS_TOKEN=
# VERTEX_AI_REFRESH_TOKEN=
