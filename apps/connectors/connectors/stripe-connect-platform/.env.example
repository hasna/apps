# Stripe Connect Platform API credentials
# Use your platform secret key from https://dashboard.stripe.com/apikeys

STRIPE_CONNECT_PLATFORM_API_KEY=sk_test_your_platform_secret_key_here

# Optional: connected account ID for Stripe-Account header (acct_...)
# STRIPE_CONNECT_PLATFORM_CONNECTED_ACCOUNT_ID=acct_your_connected_account_id

# Optional: organization account context for org API keys (sk_org_...)
# STRIPE_CONNECT_PLATFORM_ACCOUNT_ID=acct_your_org_account_id

# Optional: Stripe API version (defaults to 2025-01-27.acacia)
# STRIPE_CONNECT_PLATFORM_API_VERSION=2025-01-27.acacia

# Optional: override API base URL (defaults to https://api.stripe.com/v1)
# STRIPE_CONNECT_PLATFORM_BASE_URL=https://api.stripe.com/v1
