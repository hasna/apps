# Testmo API credentials — generate an API key from your Testmo profile page
TESTMO_API_KEY=your-api-key-here

# Optional: instance base URL (default: https://api.testmo.net/v1)
# For self-hosted or named instances use: https://your-name.testmo.net/api/v1
# TESTMO_BASE_URL=https://your-name.testmo.net/api/v1
