{
  "name": "@hasna/connect-webex",
  "version": "0.1.0",
  "description": "Cisco Webex API connector with CLI and library support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "connect-webex": "bin/index.js"
  },
  "scripts": {
    "dev": "bun run ./src/cli/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli/index.ts --outdir ./bin --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "webex",
    "cisco",
    "meetings",
    "messaging",
    "connector",
    "cli"
  ],
  "author": "Hasna",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/connectors.git"
  }
}
