# Stripe Sigma API credentials
# Uses the same secret API key as the Stripe API (sk_test_* or sk_live_*).
# Sigma must be enabled on your Stripe account.
# Get keys from https://dashboard.stripe.com/apikeys

STRIPE_SIGMA_API_KEY=sk_test_your_stripe_secret_key_here

# Alias: same key as connect-stripe
# STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# Optional: Stripe API version (Sigma query runs require a preview version)
# STRIPE_SIGMA_API_VERSION=2025-06-30.preview

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_SIGMA_BASE_URL=https://api.stripe.com/v1
