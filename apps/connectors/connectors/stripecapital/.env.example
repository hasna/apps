# Stripe Capital API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys
# Capital for platforms operates on your platform's secret key.

STRIPE_CAPITAL_API_KEY=[REDACTED]

# Optional: act on behalf of a connected account (Stripe-Account header)
# STRIPE_CAPITAL_ACCOUNT_ID=[REDACTED]

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_CAPITAL_BASE_URL=https://api.stripe.com/v1
