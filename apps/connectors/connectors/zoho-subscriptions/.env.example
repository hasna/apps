# Zoho Subscriptions OAuth access token
ZOHO_SUBSCRIPTIONS_TOKEN=your-oauth-access-token

# Zoho organization ID (required)
ZOHO_SUBSCRIPTIONS_ORG_ID=your-organization-id

# Data center: com | eu | in | com.au | jp | ca | sa (default: com)
# ZOHO_SUBSCRIPTIONS_DATA_CENTER=com

# Optional: override API base URL (defaults to https://www.zohoapis.{dc}/billing/v1)
# ZOHO_SUBSCRIPTIONS_BASE_URL=https://www.zohoapis.com/billing/v1
