# Zoho Vault OAuth access token (from Zoho OAuth flow)
ZOHOVAULT_TOKEN=your-oauth-access-token-here

# Data center: com | eu | in | com.au | jp | ca | sa (default: com)
# ZOHOVAULT_DATA_CENTER=com

# Optional: override API base URL (normally derived from data center)
# ZOHOVAULT_BASE_URL=https://vault.zoho.com/api/rest/json/v1
