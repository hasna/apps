# SupportBee API Credentials
#
# Get your auth token from your SupportBee account settings:
#   Settings -> API Token
#
# Your base URL is company-specific and looks like:
#   https://your-company.supportbee.com

# Required: SupportBee auth token (placeholder — replace with your own)
SUPPORTBEE_API_KEY=your-supportbee-auth-token

# Required: your company-specific SupportBee base URL
SUPPORTBEE_BASE_URL=https://your-company.supportbee.com

# Alternative to SUPPORTBEE_BASE_URL: just the company subdomain slug
# SUPPORTBEE_SUBDOMAIN=your-company
