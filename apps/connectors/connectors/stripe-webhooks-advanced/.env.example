# Stripe API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys

STRIPE_WEBHOOKS_ADVANCED_API_KEY=your_stripe_api_key_here

# Optional: Webhook signing secret (whsec_...) for local signature verification
# STRIPE_WEBHOOKS_ADVANCED_API_SECRET=whsec_your-webhook-secret-here

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_WEBHOOKS_ADVANCED_BASE_URL=https://api.stripe.com/v1
