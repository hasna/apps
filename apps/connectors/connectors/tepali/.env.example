# Tepali API credentials
# Get an API key from your Tepali workspace settings: https://www.tepali.com/

# Required: your Tepali API key (Bearer token)
TEPALI_API_KEY=your-api-key-here

# Optional: override the API base URL (defaults to https://api.tepali.com/v1)
# TEPALI_BASE_URL=https://api.tepali.com/v1
