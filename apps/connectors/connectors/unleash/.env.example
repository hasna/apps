# Unleash Admin API credentials
# See https://docs.getunleash.io/reference/api-tokens-and-client-keys

UNLEASH_API_KEY=your-api-token-here

# Instance-specific API root (must end with /api)
# Example: https://eu.app.unleash-hosted.com/my-instance/api
UNLEASH_BASE_URL=https://your-instance.app.unleash-hosted.com/your-instance/api

# Default project for feature flag operations
UNLEASH_PROJECT=default
