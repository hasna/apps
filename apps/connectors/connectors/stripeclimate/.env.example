# Stripe API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys

STRIPE_API_KEY=your_stripe_api_key_here

# Optional: Connected account ID for Stripe Connect (Stripe-Account header)
# STRIPE_ACCOUNT_ID=acct_your_account_id_here

# Optional: Custom base URL (defaults to https://api.stripe.com/v1)
# STRIPE_BASE_URL=https://api.stripe.com/v1
