# Stripe Treasury API Credentials
# Get your API keys from https://dashboard.stripe.com/apikeys
# Treasury requires a platform Stripe account with the Treasury capability enabled.

STRIPE_API_KEY=your_stripe_api_key_here

# Optional: connected account ID to act on behalf of (Stripe-Account header)
# Treasury financial accounts belong to connected accounts on your platform.
# STRIPE_ACCOUNT_ID=acct_your-connected-account-here

# Optional: Custom base URL (if needed, defaults to https://api.stripe.com/v1)
# STRIPE_BASE_URL=https://api.stripe.com/v1
