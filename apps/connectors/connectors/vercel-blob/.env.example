# Vercel Blob read-write token (from Vercel dashboard → Storage → your store → .env.local)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Alias supported by this connector CLI
# VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Required when using OIDC auth instead of a read-write token
# BLOB_STORE_ID=store_xxxxxxxx
# VERCEL_OIDC_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
