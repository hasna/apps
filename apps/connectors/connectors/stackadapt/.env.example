# StackAdapt API key (Account Settings → API Integration)
STACKADAPT_API_KEY=your-api-key-here

# Optional: override REST base URL (default: https://api.stackadapt.com/service/v2)
# STACKADAPT_BASE_URL=https://api.stackadapt.com/service/v2

# Optional: override GraphQL endpoint (default: https://api.stackadapt.com/graphql)
# STACKADAPT_GRAPHQL_URL=https://api.stackadapt.com/graphql
