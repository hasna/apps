# Stack Exchange API configuration
# All read endpoints work without authentication. Registering an app key at
# https://stackapps.com/apps/oauth/register raises the daily request quota.

# Optional: application key for a higher request quota (10000/day vs 300/day)
STACKEXCHANGE_KEY=your-app-key-here

# Optional: OAuth access token for authenticated / per-user endpoints
STACKEXCHANGE_ACCESS_TOKEN=your-access-token-here

# Optional: default Stack Exchange site (e.g. stackoverflow, superuser, serverfault)
STACKEXCHANGE_SITE=stackoverflow
