        "local_machine_id": {
          "type": "string"
        },
        "pagination": {
          "type": "object",
          "required": [
            "limit",
            "offset",
            "total",
            "count",
            "hasMore",
            "nextOffset",
            "has_more",
            "next_offset",
            "order"
          ],
          "properties": {
            "limit": {
              "type": [
                "number",
                "null"
              ]
