      "properties": {
        "schema_version": {
          "const": 1
        },
        "package": {
          "type": "object"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "requested_machine_id": {
          "type": "string"
        },
        "machine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "object"
        },
        "workspace": {
          "type": [
            "object",
            "null"
          ]
        },
        "cacheability": {
          "$ref": "#/$defs/cacheability"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
