        },
        "paths": {
          "type": "object"
        },
        "diagnostics": {
          "type": "array"
        },
        "repair_hints": {
          "type": "array"
        },
        "evidence": {
          "type": "object"
        },
        "cacheability": {
          "$ref": "#/$defs/cacheability"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
