            "total": {
              "type": "number"
            },
            "count": {
              "type": "number"
            },
            "hasMore": {
              "type": "boolean"
            },
            "nextOffset": {
              "type": [
                "number",
                "null"
              ]
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "number",
                "null"
              ]
            },
            "order": {
              "const": "updated_at_desc"
            }
          }
        },
        "machines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "machine_id",
              "friendly_name",
              "display_name",
              "updated_at"
            ],
            "properties": {
              "machine_id": {
                "type": "string"
              },
              "friendly_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display_name": {
                "type": "string"
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "schema_version",
        "package",
        "ok",
        "machine_id",
        "requested_machine_id",
        "generated_at",
        "route",
        "source",
        "target",
        "command_target",
        "confidence",
        "local",
        "evidence",
        "cacheability",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "package": {
          "type": "object"
        },
        "ok": {
          "type": "boolean"
        },
        "machine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_machine_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "route": {
          "enum": [
            "local",
            "lan",
            "tailscale",
            "ssh",
            "unknown"
