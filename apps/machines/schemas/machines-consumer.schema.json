    },
    "project_assignments": {
      "type": "object",
      "required": [
        "schema_version",
        "package",
        "generated_at",
        "assignments",
        "projects",
        "machines",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "package": {
          "type": "object"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "assignments": {
          "type": "array"
        },
        "projects": {
          "type": "array"
        },
        "machines": {
          "type": "array"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
