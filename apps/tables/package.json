{
  "name": "@hasna/tables",
  "version": "0.1.0",
  "description": "Headless Airtable-like data tables SDK — bases, typed fields, records, views (filter/sort/group), formula + lookup fields, CSV/JSON import-export, plus a Glide-Data-Grid React component",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tables": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "dashboard/dist",
    "docs/*.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && NODE_ENV=production bun build src/index.ts --outdir dist --target bun && NODE_ENV=production bun build src/react/index.ts --outdir dist/react --target bun --external react --external react-dom --external @glideapps/glide-data-grid && NODE_ENV=production bun build src/cli/index.ts --outdir dist/cli --target bun && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:dashboard": "cd dashboard && bun run build",
    "prepack": "bun run build >&2 && bun run build:dashboard >&2",
    "prepublishOnly": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:cli": "bun run src/cli/index.ts",
    "dev:dashboard": "cd dashboard && bun run dev",
    "postinstall": "mkdir -p $HOME/.hasna/tables 2>/dev/null || true"
  },
  "keywords": [
    "tables",
    "airtable",
    "database",
    "grid",
    "glide-data-grid",
    "spreadsheet",
    "formula",
    "csv",
    "react",
    "sdk",
    "headless",
    "hasna"
  ],
  "author": "hasna",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/tables.git"
  },
  "homepage": "https://github.com/hasna/tables",
  "bugs": {
    "url": "https://github.com/hasna/tables/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@glideapps/glide-data-grid": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "bun-types": "1.3.14",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "4.3.2",
    "typescript": "^5.8.2",
    "vite": "6.4.3"
  }
}
