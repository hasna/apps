{
  "openapi": "3.0.3",
  "info": {
    "title": "Hasna Crawl API",
    "description": "REST API of the @hasna/crawl self-hosted web crawler (crawl-serve). All /v1 endpoints require a bearer API key unless the server runs with auth disabled; the /health, /ready, /version, and /openapi.json probes are public.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    { "name": "crawls" },
    { "name": "pages" },
    { "name": "search" },
    { "name": "keys" },
    { "name": "usage" },
    { "name": "webhooks" },
    { "name": "system" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["system"],
        "summary": "Readiness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is ready to serve",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": ["system"],
        "summary": "Version probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Package name and version",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionInfo" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["system"],
        "summary": "OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "This document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/v1/keys": {
      "get": {
        "tags": ["keys"],
        "summary": "List API keys",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "API keys (key hashes omitted)",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKey" } } } }
          }
        }
      },
      "post": {
        "tags": ["keys"],
        "summary": "Create an API key",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateApiKeyInput" } } }
        },
        "responses": {
          "201": {
            "description": "Key created; raw key is returned once",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedApiKey" } } }
          }
        }
      }
    },
    "/v1/keys/{id}": {
      "delete": {
        "tags": ["keys"],
        "summary": "Revoke an API key",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Key revoked",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "revoked": { "type": "boolean" } } } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": ["usage"],
        "summary": "Usage summary",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "api_key_id", "in": "query", "schema": { "type": "string" } },
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Usage summary",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsageSummary" } } }
          }
        }
      }
    },
    "/v1/usage/events": {
      "get": {
        "tags": ["usage"],
        "summary": "Recent usage events",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "api_key_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Recent usage events",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UsageEvent" } } } }
          }
        }
      }
    },
    "/v1/crawls": {
      "get": {
        "tags": ["crawls"],
        "summary": "List crawls",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/CrawlStatus" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Crawls",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Crawl" } } } }
          }
        }
      },
      "post": {
        "tags": ["crawls"],
        "summary": "Start a crawl (sync or async)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartCrawlInput" } } }
        },
        "responses": {
          "201": {
            "description": "Crawl completed synchronously",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Crawl" } } }
          },
          "202": {
            "description": "Crawl accepted in the background",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Crawl" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/crawls/{id}": {
      "get": {
        "tags": ["crawls"],
        "summary": "Get a crawl with its first pages",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Crawl with up to 20 pages",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Crawl" }, { "type": "object", "properties": { "pages": { "type": "array", "items": { "$ref": "#/components/schemas/Page" } } } }] } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/crawls/{id}/pages": {
      "get": {
        "tags": ["crawls"],
        "summary": "List a crawl's pages",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Pages of the crawl",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Page" } } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/jobs": {
      "get": {
        "tags": ["crawls"],
        "summary": "List crawls including running (alias of GET /v1/crawls)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/CrawlStatus" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Crawls",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Crawl" } } } }
          }
        }
      }
    },
    "/v1/pages/{id}": {
      "get": {
        "tags": ["pages"],
        "summary": "Get a page",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Page",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/search": {
      "get": {
        "tags": ["search"],
        "summary": "Search crawled pages",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "domain", "in": "query", "schema": { "type": "string" } },
          { "name": "crawl_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SearchResult" } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/export/{crawlId}": {
      "get": {
        "tags": ["crawls"],
        "summary": "Export a crawl",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "crawlId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["json", "md", "csv"], "default": "json" } }
        ],
        "responses": {
          "200": {
            "description": "Crawl export in the requested format",
            "content": {
              "application/json": { "schema": { "type": "object" } },
              "text/markdown": { "schema": { "type": "string" } },
              "text/csv": { "schema": { "type": "string" } }
            }
          }
        }
      }
    },
    "/v1/config": {
      "get": {
        "tags": ["system"],
        "summary": "Current crawl configuration",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Crawl configuration",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CrawlConfig" } } }
          }
        }
      }
    },
    "/v1/batch": {
      "post": {
        "tags": ["crawls"],
        "summary": "Batch-scrape multiple URLs (always async)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchInput" } } }
        },
        "responses": {
          "202": {
            "description": "Batch job queued",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchJob" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/batch/{id}": {
      "get": {
        "tags": ["crawls"],
        "summary": "Get a batch job (alias of GET /v1/crawls/{id})",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Crawl with up to 20 pages",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Crawl" }, { "type": "object", "properties": { "pages": { "type": "array", "items": { "$ref": "#/components/schemas/Page" } } } }] } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/map": {
      "post": {
        "tags": ["crawls"],
        "summary": "Discover all URLs on a website",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MapInput" } } }
        },
        "responses": {
          "200": {
            "description": "Discovered URLs",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "urls": { "type": "array", "items": { "type": "string" } }, "count": { "type": "integer" } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "tags": ["webhooks"],
        "summary": "List webhooks",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Webhooks",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Webhook" } } } }
          }
        }
      },
      "post": {
        "tags": ["webhooks"],
        "summary": "Create a webhook",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWebhookInput" } } }
        },
        "responses": {
          "201": {
            "description": "Webhook created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Webhook" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "get": {
        "tags": ["webhooks"],
        "summary": "Get a webhook",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Webhook",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Webhook" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/webhooks/retry": {
      "post": {
        "tags": ["webhooks"],
        "summary": "Retry all failed pending webhook deliveries",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Number of deliveries retried",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "retried": { "type": "integer" } } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key minted via the CLI or POST /v1/keys."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Missing or invalid parameter",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "name": { "type": "string" }
        }
      },
      "VersionInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "CrawlStatus": {
        "type": "string",
        "enum": ["pending", "running", "completed", "failed", "cancelled"]
      },
      "Crawl": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "domain": { "type": ["string", "null"] },
          "status": { "$ref": "#/components/schemas/CrawlStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "error": { "type": ["string", "null"] }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "crawlId": { "type": "string" },
          "url": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "statusCode": { "type": ["integer", "null"] },
          "crawledAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "page": { "$ref": "#/components/schemas/Page" },
          "score": { "type": ["number", "null"] },
          "snippet": { "type": ["string", "null"] }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "keyPrefix": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "lastUsedAt": { "type": ["string", "null"], "format": "date-time" },
          "revokedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CreateApiKeyInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatedApiKey": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "Raw API key, returned once" },
          "id": { "type": "string" },
          "prefix": { "type": "string" }
        }
      },
      "UsageSummary": {
        "type": "object",
        "properties": {
          "totalCrawlPages": { "type": "integer" },
          "totalMapUrls": { "type": "integer" },
          "totalSearchResults": { "type": "integer" },
          "totalAiExtractions": { "type": "integer" },
          "totalScreenshots": { "type": "integer" }
        }
      },
      "UsageEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["crawl_page", "map_url", "search_result", "ai_extraction", "screenshot"] },
          "apiKeyId": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StartCrawlInput": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "depth": { "type": "integer" },
          "maxPages": { "type": "integer" },
          "async": { "type": "boolean", "description": "Run in the background and return 202 with the crawl record" }
        }
      },
      "BatchInput": {
        "type": "object",
        "required": ["urls"],
        "properties": {
          "urls": { "type": "array", "items": { "type": "string" } },
          "options": { "type": "object" }
        }
      },
      "BatchJob": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string" },
          "urlCount": { "type": "integer" },
          "status": { "type": "string", "enum": ["queued"] }
        }
      },
      "MapInput": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "limit": { "type": "integer", "default": 1000 },
          "search": { "type": "string" },
          "allowSubdomains": { "type": "boolean" }
        }
      },
      "CreateWebhookInput": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "events": {
            "type": "array",
            "items": { "type": "string", "enum": ["crawl.started", "crawl.completed", "crawl.failed", "page.crawled"] }
          },
          "secret": { "type": "string", "description": "Signing secret for delivered payloads" }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CrawlConfig": {
        "type": "object",
        "properties": {
          "requireAuth": { "type": "boolean" },
          "defaultDepth": { "type": "integer" },
          "defaultMaxPages": { "type": "integer" }
        }
      }
    }
  }
}
