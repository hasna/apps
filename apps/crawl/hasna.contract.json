{
  "schema": "hasna.service_contract.v1",
  "name": "crawl",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "AI-powered web crawler (self-hosted Firecrawl alternative): crawl, extract, render JS, and search, exposed through CLI, MCP, REST API, and dashboard surfaces. Stores crawl and page data in SQLite at ~/.hasna/crawl/data.db by default, or in operator-owned PostgreSQL when HASNA_CRAWL_DATABASE_URL is set.",
  "bins": [
    "crawl",
    "crawl-mcp",
    "crawl-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "crawl-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true,
        "description": "Liveness probe returning {\"status\":\"ok\"} while the server can serve."
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true,
        "description": "Readiness probe returning {\"status\":\"ok\"} while the server can serve."
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true,
        "description": "Version probe returning name and version."
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "crawl-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "crawl",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CRAWL_",
    "aliasEnvPrefix": "CRAWL_",
    "sqlitePath": "~/.hasna/crawl/data.db",
    "pgTestGate": {
      "envVar": "CRAWL_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "artifact-scan"
      }
    }
  }
}
