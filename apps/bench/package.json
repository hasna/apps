{
  "name": "@hasna/bench",
  "version": "0.0.1",
  "description": "CLI, SDK, and MCP foundation for an open-source AI benchmark aggregator and wrapper.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bench": "dist/cli/index.js",
    "bench-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/cli/index.ts --outdir dist/cli --target bun --external @modelcontextprotocol/sdk --external @hasna/contracts && bun build src/mcp/index.ts --outdir dist/mcp --target bun --external @modelcontextprotocol/sdk --external @hasna/contracts && bun build src/index.ts src/contracts.ts src/storage.ts src/sdk/index.ts --outdir dist --target bun --external @hasna/contracts && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "contracts:conformance": "contracts conformance examples/contracts",
    "dev:cli": "bun run src/cli/index.ts",
    "dev:mcp": "bun run src/mcp/index.ts",
    "pack:check": "bun pm pack --dry-run",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "postinstall": "mkdir -p $HOME/.hasna/bench 2>/dev/null || true"
  },
  "keywords": [
    "benchmark",
    "bench",
    "llm",
    "ai",
    "evals",
    "mcp",
    "cli",
    "typescript",
    "swe-bench",
    "ragas",
    "promptfoo"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/bench.git"
  },
  "homepage": "https://github.com/hasna/bench",
  "bugs": {
    "url": "https://github.com/hasna/bench/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "Andrei Hasna <andrei@hasna.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@hasna/contracts": "^0.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^6.0.2"
  }
}
