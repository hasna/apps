{
  "schema": "hasna.service_contract.v1",
  "name": "fleet",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Read-only AgentOps control tower CLI + MCP + serve. SQLite at ~/.hasna/fleet/fleet.db is authoritative when no DATABASE_URL is configured; with one, reads/writes to fleet's own config tables go directly to the operator-owned Postgres. Fused upstream observability data is read-only and never persisted as source-of-truth.",
  "bins": [
    "fleet",
    "fleet-mcp",
    "fleet-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "fleet-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1"
    },
    {
      "name": "fleet-sdk",
      "kind": "sdk",
      "status": "deferred",
      "authMode": "api-key",
      "exportSubpath": ".",
      "deferReason": "No ./sdk export or served OpenAPI document exists; the SDK surface awaits the SDK lane (c7ce8b75)."
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "fleet-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "fleet",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_FLEET_",
    "aliasEnvPrefix": "FLEET_",
    "sqlitePath": "~/.hasna/fleet/fleet.db"
  }
}
