{
  "schema": "hasna.service_contract.v1",
  "name": "secrets",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Agent-friendly secrets vault: CLI + MCP + HTTP serve + SDK. The local client keeps an on-box encrypted vault; the served API stores encrypted values in a PostgreSQL backend with strict API-key auth (@hasna/contracts).",
  "bins": [
    "secrets",
    "secrets-mcp",
    "secrets-serve"
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_SECRETS_",
    "aliasEnvPrefix": "SECRETS_",
    "pgTestGate": {
      "envVar": "SECRETS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "secrets-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "secrets-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "secrets",
      "authMode": "local-only"
    },
    {
      "name": "secrets-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "secrets-mcp",
      "authMode": "local-only"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "SecretsClient",
      "generatedFrom": "/openapi.json"
    }
  ],
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "serve": {
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "apiBase": "/v1",
      "auth": "api-key",
      "signingSecretEnv": "HASNA_SECRETS_API_SIGNING_KEY"
    }
  }
}
