{
  "manifest_version": 3,
  "name": "Secrets Vault",
  "version": "1.0.0",
  "description": "Autofill logins, addresses, and vault items from your local encrypted secrets vault",

  "permissions": ["activeTab", "tabs", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:27462/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Secrets Vault",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
