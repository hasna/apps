# syntax=docker/dockerfile:1
# Image built from the published @hasna/secrets npm tarball by the ECR image
# builder for its selected native architecture. Runs the shared secrets API.

FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS runtime

ARG VERSION=unknown
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/hasna/apps" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENV NODE_ENV=production \
    HASNA_APP_NAME=secrets \
    PORT=8080 \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem \
    PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

WORKDIR /app

RUN apk add --no-cache --upgrade ca-certificates curl \
       'libcrypto3=3.5.8-r0' 'libssl3=3.5.8-r0' \
  && curl -fsSL -o /etc/ssl/certs/rds-global-bundle.pem \
       https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
  && echo 'e5bb2084ccf45087bda1c9bffdea0eb15ee67f0b91646106e466714f9de3c7e3  /etc/ssl/certs/rds-global-bundle.pem' | sha256sum -c - \
  && addgroup -g 10001 -S secrets \
  && adduser -S -D -H -u 10001 -G secrets secrets

# Package contents (npm always ships package.json; bun.lock/dist/migrations via files[]).
COPY package.json bun.lock ./
COPY dist ./dist
COPY migrations ./migrations

# The package's desktop postinstall creates a client data directory. It is not
# part of the server image and dependency lifecycle scripts are unnecessary.
RUN bun install --production --frozen-lockfile --ignore-scripts \
  && printf '#!/bin/sh\nexec bun /app/dist/index.js "$@"\n'        > /usr/local/bin/secrets \
  && printf '#!/bin/sh\nexec bun /app/dist/server/index.js "$@"\n' > /usr/local/bin/secrets-serve \
  && printf '#!/bin/sh\nexec bun /app/dist/mcp-server.js "$@"\n'   > /usr/local/bin/secrets-mcp \
  && chmod +x /usr/local/bin/secrets /usr/local/bin/secrets-serve /usr/local/bin/secrets-mcp \
  && chown -R secrets:secrets /app

USER secrets
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bun -e "const r = await fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health'); process.exit(r.ok ? 0 : 1)"

CMD ["secrets-serve"]
