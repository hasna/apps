{
  "name": "@hasna/models",
  "version": "0.0.10",
  "description": "CLI-first local model and dataset lifecycle tool for open-source/open-weight catalogs",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage.js",
      "types": "./dist/storage.d.ts"
    },
    "./capabilities": {
      "import": "./dist/capabilities.js",
      "types": "./dist/capabilities.d.ts"
    }
  },
  "bin": {
    "models": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/cli/index.ts --outdir dist/cli --target bun && bun build src/index.ts src/storage.ts src/capabilities.ts --outdir dist --target bun && tsc --emitDeclarationOnly --outDir dist",
    "contract:check": "bun run build && contracts repo-conformance .",
    "scan-artifact": "bun scripts/scan-artifact.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run src/cli/index.ts",
    "pack:local": "bun pm pack",
    "prepack": "bun run build && bun run scan-artifact",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "models",
    "huggingface",
    "datasets",
    "gguf",
    "safetensors",
    "local-ai",
    "cli",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/models.git"
  },
  "homepage": "https://github.com/hasna/models",
  "bugs": {
    "url": "https://github.com/hasna/models/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@hasna/paths": "0.1.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@hasna/contracts": "0.11.1",
    "@types/bun": "1.3.14",
    "@types/node": "^20.14.0",
    "bun-types": "1.3.14",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
