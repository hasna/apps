{
  "name": "@hasna/computer",
  "version": "0.1.13",
  "description": "Open-source computer use for AI agents — control your Mac with Anthropic or OpenAI. CLI + MCP server + REST API + Dashboard.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "computer": "dist/cli/index.js",
    "computer-mcp": "dist/mcp/index.js",
    "computer-serve": "dist/server/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "helpers/scroll",
    "helpers/scroll.swift",
    "helpers/accessibility",
    "helpers/accessibility.swift",
    "helpers/record",
    "helpers/record.swift",
    "helpers/manifest.json",
    "src/db/migrations",
    "docs",
    "examples",
    "CHANGELOG.md",
    "dashboard/dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/cli/index.ts --outdir dist/cli --target bun --external @modelcontextprotocol/sdk --external ink --external react --external chalk && bun build src/mcp/index.ts --outdir dist/mcp --target bun --external @modelcontextprotocol/sdk && bun build src/server/index.ts --outdir dist/server --target bun && bun build src/index.ts src/storage.ts --outdir dist --target bun && tsc --emitDeclarationOnly --outDir dist && (cd dashboard && bun install --frozen-lockfile && bun run build)",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='dashboard/tests/**'",
    "test:dashboard": "cd dashboard && bun install --frozen-lockfile && bun run test:e2e",
    "verify:release": "bun run typecheck && bun run test && bun run build && bun run scripts/verify-release.ts",
    "verify:workspace": "bun run scripts/verify-workspace.ts",
    "verify:workspace:release": "bun run scripts/verify-workspace.ts --include-npm --enforce-release-ready",
    "verify:packed-cross-repo": "bun run scripts/verify-packed-cross-repo.ts",
    "run:safe-action-sampler": "bun run scripts/run-safe-action-sampler.ts",
    "dev:cli": "bun run src/cli/index.ts",
    "dev:mcp": "bun run src/mcp/index.ts",
    "dev:serve": "bun run src/server/index.ts",
    "prepublishOnly": "bun run verify:workspace:release && bun run verify:release",
    "postinstall": "mkdir -p $HOME/.hasna/computer 2>/dev/null || true"
  },
  "keywords": [
    "computer-use",
    "ai-agent",
    "desktop-automation",
    "macos",
    "anthropic",
    "openai",
    "mcp",
    "cli",
    "screenshot",
    "mouse-control"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hasna/open-computer.git"
  },
  "homepage": "https://github.com/hasna/open-computer",
  "bugs": {
    "url": "https://github.com/hasna/open-computer/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "Andrei Hasna <andrei@hasna.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/openai": "3.0.69",
    "@anthropic-ai/sdk": "^0.39.0",
    "@hasna/events": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ai": "6.0.200",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "openai": "^4.85.0",
    "pg": "^8.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
