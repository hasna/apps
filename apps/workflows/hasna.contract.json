{
  "schema": "hasna.service_contract.v1",
  "name": "workflows",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Universal graph workflow app: graph language (start/step/decision/while/end), three-table run store, session WAL, claims/leases daemon, four lane adapters (claude, codex, cursor, grok), and a full CLI on four surfaces (CLI, MCP, serve, SDK). Local state lives at the effective workflows data home (~/.hasna/workflows by default, resolved via @hasna/paths; the XDG data home is adopted once the store is migrated there or HASNA_DATA_HOME is set).",
  "bins": [
    "workflows",
    "workflows-mcp",
    "workflows-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "workflows-serve",
      "authMode": "local-only",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "local-only",
      "exportSubpath": "./sdk",
      "clientClassName": "WorkflowsService",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "workflows-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "workflows",
      "authMode": "local-only"
    }
  ],
  "metadata": {
    "serve": {
      "healthEndpoints": [
        "/health",
        "/ready",
        "/version"
      ],
      "openapi": "/openapi.json",
      "auth": "local-only"
    },
    "release": {
      "artifactScan": {
        "script": "artifact-scan"
      }
    }
  },
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_WORKFLOWS_",
    "aliasEnvPrefix": "WORKFLOWS_",
    "sqlitePath": "~/.hasna/workflows/workflows.db",
    "pgTestGate": {
      "envVar": "WORKFLOWS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  }
}
