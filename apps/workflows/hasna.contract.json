{
  "schema": "hasna.service_contract.v1",
  "name": "workflows",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.14.0",
  "description": "Scaffold of the universal graph workflow app: version/health/readiness on all four surfaces (CLI, MCP, serve, SDK). The graph language, three-table store, session WAL, claims/leases daemon, and lane adapters (claude, codex, cursor, grok) are roadmap slices not shipped in 0.1.0.",
  "bins": [
    "workflows",
    "workflows-mcp",
    "workflows-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "workflows-serve",
      "authMode": "local-only",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "WorkflowsService",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "workflows-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "workflows",
      "authMode": "local-only"
    }
  ],
  "metadata": {
    "serve": {
      "healthEndpoints": [
        "/health",
        "/ready",
        "/version"
      ],
      "openapi": "/openapi.json",
      "auth": "local-only"
    },
    "release": {
      "artifactScan": {
        "script": "artifact-scan"
      }
    }
  },
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_WORKFLOWS_",
    "aliasEnvPrefix": "WORKFLOWS_",
    "sqlitePath": "~/.hasna/workflows/workflows.db",
    "pgTestGate": {
      "envVar": "WORKFLOWS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  }
}
