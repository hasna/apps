{
  "schema": "hasna.service_contract.v1",
  "name": "consolidations",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.14.1",
  "description": "Group financial consolidation CLI + MCP + serve. SQLite at ~/.hasna/consolidations/consolidations.db is the default server data backend; a HASNA_CONSOLIDATIONS_DATABASE_URL selects PostgreSQL via the vendored storage kit. Legacy storage-mode variables are rejected.",
  "bins": [
    "consolidations",
    "consolidations-mcp",
    "consolidations-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "consolidations-api",
      "kind": "api",
      "status": "supported",
      "bin": "consolidations-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/v1/openapi.json"
    },
    {
      "name": "consolidations-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": ".",
      "generatedFrom": "/v1/openapi.json"
    },
    {
      "name": "consolidations-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "consolidations",
      "authMode": "local-only"
    },
    {
      "name": "consolidations-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "consolidations-mcp",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_CONSOLIDATIONS_",
    "aliasEnvPrefix": "CONSOLIDATIONS_",
    "sqlitePath": "~/.hasna/consolidations/consolidations.db",
    "pgTestGate": {
      "envVar": "CONSOLIDATIONS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan-artifact"
      }
    }
  }
}
