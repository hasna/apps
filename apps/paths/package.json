{
  "name": "@hasna/paths",
  "version": "0.2.1",
  "description": "Package-owned path resolver for Hasna apps — XDG and macOS home layout honoring HASNA_*_HOME overrides.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/apps.git"
  },
  "homepage": "https://github.com/hasna/apps#readme",
  "bugs": {
    "url": "https://github.com/hasna/apps/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bin": {
    "paths": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "hasna.contract.json"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/cli/index.ts --outdir dist --target bun && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "scan:artifact": "bun scripts/scan-artifact.ts",
    "prepack": "bun run scan:artifact",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run scan:artifact"
  },
  "keywords": [
    "paths",
    "xdg",
    "resolver",
    "hasna"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@hasna/contracts": "0.14.2",
    "@types/bun": "^1.2.4",
    "@types/node": "^26.0.0",
    "bun-types": "1.3.14",
    "typescript": "^5.7.3"
  }
}
