{
  "schema": "hasna.service_contract.v1",
  "name": "logs",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Agent-friendly log + telemetry sink. CLI + MCP + HTTP API (logs-serve) + SDK. SQLite at ~/.hasna/logs/logs.db is authoritative when no DATABASE_URL is configured; with one, the serve process reads/writes the operator-owned Postgres directly, with API-key auth via @hasna/contracts. This is the shared S3-backed log sink other apps route to.",
  "bins": [
    "logs",
    "logs-mcp",
    "logs-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "logs-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "logs-sdk",
      "kind": "sdk",
      "status": "deferred",
      "authMode": "api-key",
      "exportSubpath": ".",
      "deferReason": "The generated SDK ships, but the service contract requires a supported service SDK to declare an exportSubpath that exists in package.json exports with a generatedFrom pointing at the served OpenAPI document; logs exports only '.', './storage', and './api', and no ./sdk export exists yet."
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "logs-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "logs",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_LOGS_",
    "aliasEnvPrefix": "LOGS_",
    "sqlitePath": "~/.hasna/logs/logs.db"
  },
  "metadata": {
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "migrationCommand": [
        "logs",
        "db",
        "migrate"
      ]
    },
    "client": {
      "apiUrlEnv": "LOGS_API_URL",
      "apiKeyEnv": "LOGS_API_KEY"
    }
  }
}
