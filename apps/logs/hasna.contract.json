{
  "schema": "hasna.service_contract.v1",
  "name": "logs",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Agent-friendly log + telemetry sink. CLI + MCP + HTTP API (logs-serve) + generated SDK. SQLite at ~/.hasna/logs/logs.db is authoritative when no DATABASE_URL is configured; with one, the serve process reads/writes the shared cloud Postgres directly, with API-key auth via @hasna/contracts. This is the shared S3-backed log sink other apps route to.",
  "bins": [
    "logs",
    "logs-mcp",
    "logs-serve"
  ],
  "storage": {
    "envPrefix": "HASNA_LOGS_",
    "aliasEnvPrefix": "LOGS_",
    "databaseUrlSecretRef": "hasna/oss/logs/database-url",
    "sqlitePath": "~/.hasna/logs/logs.db",
    "backend": "sqlite"
  },
  "metadata": {
    "service": {
      "port": 8080,
      "healthPath": "/health",
      "readyPath": "/ready",
      "versionPath": "/version",
      "openapiPath": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key",
      "signingSecretSecretRef": "hasna/oss/logs/api-key-signing-secret",
      "migrationCommand": [
        "logs",
        "db",
        "migrate"
      ],
      "ownerDatabaseUrlSecretRef": "hasna/oss/logs/database-url-owner"
    },
    "client": {
      "apiUrlEnv": "LOGS_API_URL",
      "apiKeyEnv": "LOGS_API_KEY"
    }
  }
}
