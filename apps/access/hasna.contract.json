{
  "$schema": "./node_modules/@hasna/contracts/src/hasna.contract.schema.json",
  "schema": "hasna.service_contract.v1",
  "name": "access",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.14.2",
  "description": "Non-human-identity governance: 43 core CLI and SDK operations use authenticated explicit HTTPS; access-serve requires server PostgreSQL. Migration is partial: legacy root exports, MCP authentication/tools and postinstall paths retain their existing behavior pending separate boundary decisions.",
  "bins": [
    "access",
    "access-mcp",
    "access-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "access-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "package-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "access-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "access",
      "authMode": "api-key"
    }
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "postgresql",
      "sqlite"
    ],
    "envPrefix": "HASNA_ACCESS_",
    "aliasEnvPrefix": "ACCESS_",
    "pgTestGate": {
      "envVar": "ACCESS_TEST_DATABASE_URL",
      "command": "bun scripts/pg-test-gate.mjs"
    }
  },
  "metadata": {
    "canonicalMigration": {
      "status": "partial",
      "completedSurfaces": ["cli", "./sdk", "http-api"],
      "remainingSurfaces": ["root-library", "mcp", "postinstall", "legacy-xdg-adoption", "live-postgresql-domain-proof"]
    },
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
