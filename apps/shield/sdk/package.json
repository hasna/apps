{
  "name": "@hasna/shield-sdk",
  "version": "0.1.0",
  "description": "REST client SDK for security server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./schemas": { "import": "./dist/schemas.js", "types": "./dist/schemas.d.ts" }
  },
  "scripts": {
    "check:secrets": "bun ../src/cli/index.tsx oss-secrets-policy . --strict",
    "build": "bun build src/index.ts src/schemas.ts --outdir dist --target node && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepublishOnly": "bun run check:secrets && bun run build",
    "release:check": "bun run check:secrets",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
