{
  "schema": "hasna.service_contract.v1",
  "name": "shortlinks",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "1.0.2",
  "description": "Open-source shortlink manager for custom domains and click tracking, with CLI, MCP, REST API (shortlinks-serve), redirect origin, and generated SDK. shortlinks-serve is PostgreSQL-only and fails closed without HASNA_SHORTLINKS_DATABASE_URL. Clients resolve Shortlinks authority and credentials through the @hasna/contracts 1.0.2 chain or explicitly opt into on-box SQLite with HASNA_SHORTLINKS_LOCAL=1. Custom-domain availability and capped purchase intent are delegated exclusively to a Domains API (default https://api.hasna.com/domains/v1; self-hostable with HASNA_DOMAINS_API_URL); registrar, DNS, delegation, and router binding implementation never lives in Shortlinks. Pending domains are non-routable and only Domains-ready projections activate.",
  "bins": [
    "shortlinks",
    "shortlinks-mcp",
    "shortlinks-serve"
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_SHORTLINKS_",
    "aliasEnvPrefix": "SHORTLINKS_",
    "pgTestGate": {
      "envVar": "SHORTLINKS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    },
    "sqlitePath": "~/.hasna/shortlinks/shortlinks.db"
  },
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "shortlinks-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "ShortlinksApiClient",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "shortlinks-mcp",
      "authMode": "api-key"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "shortlinks",
      "authMode": "api-key"
    }
  ],
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "serve": {
      "port": 8080,
      "probes": [
        "/health",
        "/ready",
        "/version"
      ],
      "openapi": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key (@hasna/contracts)"
    }
  }
}
