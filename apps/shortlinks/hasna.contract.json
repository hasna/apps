{
  "schema": "hasna.service_contract.v1",
  "name": "shortlinks",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "1.0.0",
  "description": "Open-source shortlink manager for custom domains, click tracking, and Cloudflare/Postgres runtime support, with a CLI, MCP server, REST API (shortlinks-serve), and a generated SDK. The server data backend (sqlite | postgresql) is selected by the DATABASE_URL environment contract; clients use on-box SQLite or the hosted /v1 API.",
  "bins": [
    "shortlinks",
    "shortlinks-mcp",
    "shortlinks-serve"
  ],
  "storage": {
    "backend": "postgresql",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_SHORTLINKS_",
    "aliasEnvPrefix": "SHORTLINKS_",
    "pgTestGate": {
      "envVar": "SHORTLINKS_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    },
    "sqlitePath": "~/.hasna/shortlinks/shortlinks.db"
  },
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "shortlinks-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": "./sdk",
      "clientClassName": "ShortlinksApiClient",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "shortlinks-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "shortlinks",
      "authMode": "local-only"
    }
  ],
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "serve": {
      "port": 8080,
      "probes": [
        "/health",
        "/ready",
        "/version"
      ],
      "openapi": "/openapi.json",
      "apiVersion": "v1",
      "auth": "api-key (@hasna/contracts)"
    }
  }
}
