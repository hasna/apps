# Optional: override the local SQLite database path.
# SHORTLINKS_DB=/Users/you/.hasna/shortlinks/shortlinks.db

# Optional: salt used before hashing click IP addresses.
# SHORTLINKS_CLICK_SALT=change-me

# Optional: Cloudflare API token for DNS setup commands.
# CLOUDFLARE_API_TOKEN=...

# Optional: Cloudflare global API key auth alternative.
# CLOUDFLARE_API_KEY=...
# CLOUDFLARE_EMAIL=you@example.com

# Optional: central redirect server origin used by generated Cloudflare Workers.
# SHORTLINKS_ORIGIN=https://shortlinks.example.com

# Required for mutating admin API routes. Without this token, POST/DELETE admin
# API requests fail closed even if the origin is accidentally exposed.
# SHORTLINKS_API_TOKEN=change-me
# HASNA_SHORTLINKS_API_TOKEN=change-me

# Optional: move the origin admin API off the public /api prefix.
# SHORTLINKS_API_PATH_PREFIX=/_shortlinks/api

# Optional: canonical production RDS. Load AWS Secrets Manager
# hasna/xyz/opensource/shortlinks/prod/rds `database_url` into the primary env.
# HASNA_SHORTLINKS_DATABASE_URL=postgres://...
# SHORTLINKS_DATABASE_URL=postgres://... # rollback/local fallback
