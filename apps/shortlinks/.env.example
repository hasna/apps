# Optional: override the local SQLite database path.
# SHORTLINKS_DB=/Users/you/.hasna/shortlinks/shortlinks.db

# Optional: serve directly from the app-owned PostgreSQL database.
# HASNA_SHORTLINKS_STORE=postgres
# HASNA_SHORTLINKS_DATABASE_URL=postgres://shortlinks:password@db.example.com:5432/shortlinks
# HASNA_SHORTLINKS_DATABASE_SSL=true

# Optional: salt used before hashing click IP addresses.
# SHORTLINKS_CLICK_SALT=change-me

# Optional: Cloudflare API token for DNS setup commands.
# CLOUDFLARE_API_TOKEN=...

# Optional: Cloudflare global API key auth alternative.
# CLOUDFLARE_API_KEY=...
# CLOUDFLARE_EMAIL=you@example.com

# Optional: central redirect server origin used by generated Cloudflare Workers.
# SHORTLINKS_ORIGIN=https://shortlinks.example.com
