{
  "schema": "hasna.service_contract.v1",
  "name": "search",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.11.1",
  "description": "Unified search for machines and agents \u2014 local file index plus web providers and YouTube transcription; CLI + MCP + REST API + dashboard.",
  "hosting": [
    "user-hosted"
  ],
  "bins": [
    "search",
    "search-mcp",
    "search-serve"
  ],
  "serviceSurfaces": [
    {
      "name": "search-api",
      "kind": "api",
      "status": "supported",
      "bin": "search-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true,
        "description": "Liveness probe: { status, version, backend }"
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true,
        "description": "Readiness probe: { ready }"
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true,
        "description": "Version probe: { name, version }"
      },
      "openApiPath": "/openapi.json"
    },
    {
      "name": "search-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "none",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "search-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "search",
      "authMode": "local-only"
    },
    {
      "name": "search-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "search-mcp",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "backend": "sqlite",
    "engines": [
      "sqlite",
      "postgresql"
    ],
    "envPrefix": "HASNA_SEARCH_",
    "aliasEnvPrefix": "SEARCH_",
    "sqlitePath": "~/.hasna/search/data.db",
    "pgTestGate": {
      "envVar": "HASNA_SEARCH_TEST_DATABASE_URL",
      "command": "HASNA_SEARCH_DATABASE_URL=$HASNA_SEARCH_TEST_DATABASE_URL bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    }
  }
}
